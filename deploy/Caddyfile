# Caddyfile for the landing container.
#
# This is the INNER Caddy: it only serves files over plain HTTP on :80 inside
# the Docker network. TLS, domain routing and redirects belong to the edge
# Caddy that fronts every container on the host — see deploy/Caddyfile.edge.
{
	# The edge proxy terminates TLS; this instance must not try to obtain
	# certificates of its own.
	auto_https off
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	# Cheap liveness target for HEALTHCHECK and for the edge proxy. Declared
	# before the file server so it never touches disk.
	handle /healthz {
		respond "ok" 200
	}

	# Astro fingerprints everything under /_astro/, so those URLs can never
	# point at different bytes. Cache them for a year.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Everything else must revalidate: the URLs are stable, the bytes are not.
	# Matching by negation on purpose — pages are served as directory URLs like
	# `/servicios/`, so a `*.html` matcher silently misses every page but the
	# root. Also covers robots.txt, the sitemap and the unfingerprinted images.
	@revalidate not path /_astro/*
	header @revalidate Cache-Control "public, max-age=0, must-revalidate"

	header {
		# HSTS is set by the edge, which is the only hop that speaks TLS.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# The site ships no third-party scripts and no client-side JS bundle:
		# the only scripts are the two inline blocks in Layout.astro, which is
		# why 'unsafe-inline' is required here. Revisit if that ever changes.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	file_server
}
