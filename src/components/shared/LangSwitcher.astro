---
// LangSwitcher.astro — Static ES/EN pill UI (no i18n routing)
---

<div
  style="
    display: flex;
    gap: 2px;
    border: 1px solid var(--cf-rule);
    border-radius: 999px;
    padding: 3px;
  "
  role="group"
  aria-label="Selector de idioma"
>
  <button
    aria-pressed="true"
    style="
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
      padding: 4px 10px;
      border-radius: 999px;
      border: none;
      background: var(--cf-navy);
      color: #fff;
      cursor: pointer;
    "
  >ES</button>
  <button
    aria-pressed="false"
    style="
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
      padding: 4px 10px;
      border-radius: 999px;
      border: none;
      background: transparent;
      color: var(--cf-dim);
      cursor: pointer;
    "
  >EN</button>
</div>
