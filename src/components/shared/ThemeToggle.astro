---
// ThemeToggle.astro — 36×36 circular button, sun/moon icon
---

<button
  id="theme-toggle"
  aria-label="Cambiar a modo oscuro"
  style="
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--cf-rule);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--cf-dim);
    transition: border-color 0.2s, color 0.2s;
  "
>
  <!-- Sun icon (shown in dark mode — click to go light) -->
  <svg id="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <!-- Moon icon (shown in light mode — click to go dark) -->
  <svg id="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    var iconSun = document.getElementById('icon-sun');
    var iconMoon = document.getElementById('icon-moon');

    function applyIconState(isDark) {
      if (iconSun) iconSun.style.display = isDark ? 'block' : 'none';
      if (iconMoon) iconMoon.style.display = isDark ? 'none' : 'block';
      if (btn) btn.setAttribute('aria-label', isDark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
    }

    // Init icon from current state
    applyIconState(document.documentElement.classList.contains('dark'));

    if (btn) {
      btn.addEventListener('click', function () {
        var isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('cf-theme', isDark ? 'dark' : 'light');
        applyIconState(isDark);
      });
    }

    // Cross-tab sync
    window.addEventListener('storage', function (e) {
      if (e.key === 'cf-theme') {
        var dark = e.newValue === 'dark';
        document.documentElement.classList[dark ? 'add' : 'remove']('dark');
        applyIconState(dark);
      }
    });
  })();
</script>
