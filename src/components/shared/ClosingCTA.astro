---
import Eyebrow from './Eyebrow.astro';
---

<section
  id="contacto"
  style="
    background: var(--cf-navy-deep);
    color: #FFFFFF;
    padding: 140px 40px;
    position: relative;
    overflow: hidden;
  "
>
  <!-- Radial gradient overlay -->
  <div
    aria-hidden="true"
    style="
      position: absolute;
      inset: 0;
      background-image: radial-gradient(ellipse 60% 60% at 50% 100%, rgba(14,164,114,0.22), transparent 70%);
      pointer-events: none;
    "
  ></div>

  <div
    style="
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 40px;
      position: relative;
      text-align: center;
    "
  >
    <!-- Eyebrow -->
    <div
      class="cf-reveal"
      data-cf-reveal
      style="margin-bottom: 28px; display: flex; justify-content: center;"
    >
      <Eyebrow color="var(--cf-brand)">Próximo paso</Eyebrow>
    </div>

    <!-- Heading -->
    <h2
      class="cf-reveal"
      data-cf-reveal
      style="
        font-family: 'Geist', system-ui, sans-serif;
        font-size: 88px;
        font-weight: 600;
        letter-spacing: -0.04em;
        margin: 0;
        line-height: 1.0;
        color: #FFFFFF;
      "
    >
      Hablemos del sistema<br />
      que tu equipo <span style="color: var(--cf-brand);">está esperando</span>.
    </h2>

    <!-- Body copy -->
    <p
      class="cf-reveal"
      data-cf-reveal
      style="
        font-size: 18px;
        color: #9BA6BE;
        max-width: 580px;
        margin: 32px auto 44px;
        line-height: 1.65;
      "
    >
      30 minutos. Sin pitch ni venta dura. Cuéntanos tu reto y te decimos honestamente si podemos ayudar.
    </p>

    <!-- CTAs -->
    <div
      class="cf-reveal"
      data-cf-reveal
      style="display: inline-flex; gap: 14px; flex-wrap: wrap; justify-content: center;"
    >
      <a
        href="#"
        class="cf-btn"
        style="
          display: inline-flex;
          align-items: center;
          gap: 10px;
          padding: 16px 28px;
          font-size: 15px;
          font-weight: 600;
          color: var(--cf-ink);
          background: var(--cf-brand);
          border-radius: 8px;
          font-family: 'Geist', system-ui, sans-serif;
          text-decoration: none;
          white-space: nowrap;
        "
      >
        Agendar consulta de 30 min <span>→</span>
      </a>
      <a
        href="mailto:camandrefactory@gmail.com"
        class="cf-btn"
        style="
          display: inline-flex;
          align-items: center;
          gap: 10px;
          padding: 16px 28px;
          font-size: 15px;
          font-weight: 500;
          color: #FFFFFF;
          background: transparent;
          border: 1px solid rgba(255,255,255,0.25);
          border-radius: 8px;
          font-family: 'Geist', system-ui, sans-serif;
          text-decoration: none;
          white-space: nowrap;
        "
      >
        camandrefactory@gmail.com
      </a>
    </div>

    <!-- Contact Form -->
    <div
      class="cf-reveal"
      data-cf-reveal
      style="
        margin-top: 64px;
        border-top: 1px solid rgba(255,255,255,0.12);
        padding-top: 56px;
      "
    >
      <form
        id="cf-contact-form"
        style="
          max-width: 560px;
          margin: 0 auto;
          text-align: left;
          display: flex;
          flex-direction: column;
          gap: 20px;
        "
        novalidate
      >
        <!-- Name -->
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <label
            for="cf-name"
            style="
              font-family: 'JetBrains Mono', monospace;
              font-size: 11px;
              font-weight: 500;
              text-transform: uppercase;
              letter-spacing: 0.08em;
              color: rgba(255,255,255,0.5);
            "
          >Nombre</label>
          <input
            id="cf-name"
            name="name"
            type="text"
            autocomplete="name"
            required
            placeholder="Tu nombre"
            style="
              background: rgba(255,255,255,0.07);
              border: 1px solid rgba(255,255,255,0.15);
              border-radius: 8px;
              color: #FFFFFF;
              padding: 14px 16px;
              font-size: 15px;
              font-family: 'Geist', system-ui, sans-serif;
              outline: none;
              transition: border-color 0.2s;
              width: 100%;
              box-sizing: border-box;
            "
          />
        </div>

        <!-- Email -->
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <label
            for="cf-email"
            style="
              font-family: 'JetBrains Mono', monospace;
              font-size: 11px;
              font-weight: 500;
              text-transform: uppercase;
              letter-spacing: 0.08em;
              color: rgba(255,255,255,0.5);
            "
          >Email</label>
          <input
            id="cf-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="tu@empresa.com"
            style="
              background: rgba(255,255,255,0.07);
              border: 1px solid rgba(255,255,255,0.15);
              border-radius: 8px;
              color: #FFFFFF;
              padding: 14px 16px;
              font-size: 15px;
              font-family: 'Geist', system-ui, sans-serif;
              outline: none;
              transition: border-color 0.2s;
              width: 100%;
              box-sizing: border-box;
            "
          />
        </div>

        <!-- Message -->
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <label
            for="cf-message"
            style="
              font-family: 'JetBrains Mono', monospace;
              font-size: 11px;
              font-weight: 500;
              text-transform: uppercase;
              letter-spacing: 0.08em;
              color: rgba(255,255,255,0.5);
            "
          >Mensaje</label>
          <textarea
            id="cf-message"
            name="message"
            required
            rows="5"
            placeholder="Contanos tu reto o proyecto..."
            style="
              background: rgba(255,255,255,0.07);
              border: 1px solid rgba(255,255,255,0.15);
              border-radius: 8px;
              color: #FFFFFF;
              padding: 14px 16px;
              font-size: 15px;
              font-family: 'Geist', system-ui, sans-serif;
              outline: none;
              transition: border-color 0.2s;
              width: 100%;
              box-sizing: border-box;
              resize: vertical;
            "
          ></textarea>
        </div>

        <!-- Submit -->
        <div>
          <button
            type="submit"
            style="
              display: inline-flex;
              align-items: center;
              gap: 10px;
              padding: 16px 28px;
              font-size: 15px;
              font-weight: 600;
              color: var(--cf-ink);
              background: var(--cf-brand);
              border: none;
              border-radius: 8px;
              font-family: 'Geist', system-ui, sans-serif;
              cursor: pointer;
              white-space: nowrap;
              transition: opacity 0.2s;
            "
          >
            Enviar mensaje →
          </button>
          <p
            id="cf-form-status"
            style="
              margin-top: 12px;
              font-size: 14px;
              font-family: 'Geist', system-ui, sans-serif;
              min-height: 20px;
            "
          ></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('cf-contact-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const status = document.getElementById('cf-form-status') as HTMLParagraphElement;

      btn.disabled = true;
      btn.textContent = 'Enviando...';

      const data = Object.fromEntries(new FormData(form));

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();

        if (json.ok) {
          status.textContent = '¡Mensaje enviado! Te contactamos pronto.';
          status.style.color = 'var(--cf-brand)';
          form.reset();
        } else {
          status.textContent = json.error || 'Error al enviar. Escribinos a camandrefactory@gmail.com';
          status.style.color = '#FF6B6B';
        }
      } catch {
        status.textContent = 'Error de conexión. Intentá de nuevo.';
        status.style.color = '#FF6B6B';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Enviar mensaje →';
      }
    });
  }
</script>
