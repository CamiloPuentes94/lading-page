---
import Eyebrow from './Eyebrow.astro';
---

<section
  id="contacto"
  class="py-24 px-5 md:py-28 md:px-10 lg:py-36"
  style="
    background: var(--cf-navy-deep);
    color: #FFFFFF;
    position: relative;
    overflow: hidden;
  "
>
  <!-- Radial gradient overlay -->
  <div
    aria-hidden="true"
    style="
      position: absolute;
      inset: 0;
      background-image: radial-gradient(ellipse 60% 60% at 50% 100%, rgba(14,164,114,0.22), transparent 70%);
      pointer-events: none;
    "
  ></div>

  <div
    class="px-5 md:px-10"
    style="
      max-width: 1240px;
      margin: 0 auto;
      position: relative;
      text-align: center;
    "
  >
    <!-- Eyebrow -->
    <div
      class="cf-reveal"
      data-cf-reveal
      style="margin-bottom: 28px; display: flex; justify-content: center;"
    >
      <Eyebrow color="var(--cf-brand)">Próximo paso</Eyebrow>
    </div>

    <!-- Heading -->
    <h2
      class="cf-reveal"
      data-cf-reveal
      style="
        font-family: 'Geist Sans', system-ui, sans-serif;
        font-size: clamp(36px, 7vw, 88px);
        font-weight: 600;
        letter-spacing: -0.04em;
        margin: 0;
        line-height: 1.0;
        color: #FFFFFF;
      "
    >
      Hablemos del sistema<br />
      que tu equipo <span style="color: var(--cf-brand);">está esperando</span>.
    </h2>

    <!-- Body copy -->
    <p
      class="cf-reveal"
      data-cf-reveal
      style="
        font-size: 18px;
        color: #9BA6BE;
        max-width: 580px;
        margin: 32px auto 44px;
        line-height: 1.65;
      "
    >
      30 minutos. Sin pitch ni venta dura. Cuéntanos tu reto y te decimos honestamente si podemos ayudar.
    </p>

    <!-- CTAs -->
    <div
      class="cf-reveal flex flex-col sm:flex-row"
      data-cf-reveal
      style="gap: 14px; flex-wrap: wrap; justify-content: center; align-items: center;"
    >
      <a
        href="https://wa.me/573134212476?text=Hola%2C%20quiero%20agendar%20una%20consulta%20de%2030%20minutos%20con%20Camandre%20Factory."
        target="_blank"
        rel="noopener noreferrer"
        class="cf-btn"
        style="
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 10px;
          padding: 16px 28px;
          font-size: 15px;
          font-weight: 600;
          color: var(--cf-on-brand);
          background: var(--cf-brand);
          border-radius: 8px;
          font-family: 'Geist Sans', system-ui, sans-serif;
          text-decoration: none;
        "
      >
        Agendar consulta de 30 min <span>→</span>
      </a>
      <a
        href="mailto:camandrefactory@gmail.com"
        class="cf-btn"
        style="
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 10px;
          padding: 16px 28px;
          font-size: 15px;
          font-weight: 500;
          color: #FFFFFF;
          background: transparent;
          border: 1px solid rgba(255,255,255,0.25);
          border-radius: 8px;
          font-family: 'Geist Sans', system-ui, sans-serif;
          text-decoration: none;
        "
      >
        camandrefactory@gmail.com
      </a>
    </div>
  </div>
</section>
