---
interface Props {
  color?: string;
}

const { color = 'var(--cf-brand)' } = Astro.props;
---

<div
  style={`
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    letter-spacing: 0.18em;
    color: ${color};
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    white-space: nowrap;
  `}
>
  <span style={`width: 16px; height: 1px; background: ${color}; display: inline-block; flex-shrink: 0;`}></span>
  <slot />
</div>
