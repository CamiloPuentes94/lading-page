---
// Footer.astro — Full 4-column footer on cf-navy-deep background
import { CURRENT_YEAR, COPYRIGHT_RANGE } from '../../data/company';
---

<footer
  class="px-5 md:px-10 pt-16 md:pt-20 lg:pt-[88px] pb-8 md:pb-9"
  style="
    background: var(--cf-navy-deep);
    color: var(--cf-dark-text);
  "
>
  <div style="max-width: 1240px; margin: 0 auto;">

    <!-- Top grid: 4 columns -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1.5fr] gap-8 lg:gap-12"
      style="
        padding-bottom: 64px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
      "
    >
      <!-- Column 1: Logo + description -->
      <div>
        <!-- Logo (dark variant) -->
        <a
          href="/"
          aria-label="Camandre Factory"
          style="display: flex; align-items: center; gap: 10px; text-decoration: none; margin-bottom: 20px;"
        >
          <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
            <path
              d="M 32 11 A 14 14 0 1 0 32 29"
              fill="none"
              stroke="#ffffff"
              stroke-width="3.8"
              stroke-linecap="round"
            />
            <path
              d="M14.5 27 L20 13 L25.5 27 M16.6 22.5 L23.4 22.5"
              stroke="var(--cf-brand)"
              stroke-width="2.6"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M22.5 22.5 L31 30.6 L27.8 31.1 L29.6 34.3 L27.6 35.4 L25.8 32.2 L23.4 33.6 Z"
              fill="var(--cf-brand)"
              stroke="#ffffff"
              stroke-width="0.8"
              stroke-linejoin="round"
            />
          </svg>
          <div style="display: flex; flex-direction: column; gap: 0;">
            <span
              style="
                font-size: 15px;
                font-weight: 600;
                letter-spacing: 0.04em;
                color: #ffffff;
                line-height: 1.1;
              "
            >CAMANDRE</span>
            <span
              style="
                font-family: 'JetBrains Mono', monospace;
                font-size: 9.5px;
                font-weight: 500;
                letter-spacing: 0.32em;
                color: var(--cf-brand);
                line-height: 1.1;
              "
            >FACTORY</span>
          </div>
        </a>

        <p
          style="
            font-size: 14px;
            line-height: 1.7;
            color: var(--cf-dark-dim);
            max-width: 300px;
            margin: 0 0 24px;
          "
        >
          Una fábrica de software boutique. Diseñamos, construimos y mantenemos los sistemas que sostienen la operación diaria de pymes colombianas.
        </p>

        <!-- Availability badge with pulse -->
        <div
          style="
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid rgba(34,197,142,0.30);
            border-radius: 999px;
            padding: 6px 14px;
          "
        >
          <span
            class="cf-pulse"
            style="
              display: inline-block;
              width: 8px;
              height: 8px;
              border-radius: 50%;
              background: var(--cf-brand);
              flex-shrink: 0;
            "
            aria-hidden="true"
          ></span>
          <span
            style="
              font-family: 'JetBrains Mono', monospace;
              font-size: 11px;
              font-weight: 500;
              letter-spacing: 0.06em;
              color: var(--cf-brand);
            "
          >Aceptamos proyectos · {CURRENT_YEAR}</span>
        </div>
      </div>

      <!-- Column 2: Servicios -->
      <div>
        <p
          style="
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.18em;
            color: var(--cf-dark-dim);
            margin: 0 0 20px;
            text-transform: uppercase;
          "
        >Servicios</p>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0;">
          <li><a href="/servicios/#producto" class="cf-tap cf-footer-link" style="color: var(--cf-dark-text); text-decoration: none; font-size: 14px;">Producto Web</a></li>
          <li><a href="/servicios/#sistemas" class="cf-tap cf-footer-link" style="color: var(--cf-dark-text); text-decoration: none; font-size: 14px;">Sistemas a medida</a></li>
          <li><a href="/servicios/#infra" class="cf-tap cf-footer-link" style="color: var(--cf-dark-text); text-decoration: none; font-size: 14px;">Infraestructura</a></li>
          <li><a href="/servicios/#consultoria" class="cf-tap cf-footer-link" style="color: var(--cf-dark-text); text-decoration: none; font-size: 14px;">Consultoría TI</a></li>
        </ul>
      </div>

      <!-- Column 3: Camandre -->
      <div>
        <p
          style="
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.18em;
            color: var(--cf-dark-dim);
            margin: 0 0 20px;
            text-transform: uppercase;
          "
        >Camandre</p>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0;">
          <li><a href="/nosotros/" class="cf-tap cf-footer-link" style="color: var(--cf-dark-text); text-decoration: none; font-size: 14px;">Nosotros</a></li>
          <li><a href="/portafolio/" class="cf-tap cf-footer-link" style="color: var(--cf-dark-text); text-decoration: none; font-size: 14px;">Portafolio</a></li>
        </ul>
      </div>

      <!-- Column 4: Contacto -->
      <div>
        <p
          style="
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.18em;
            color: var(--cf-dark-dim);
            margin: 0 0 20px;
            text-transform: uppercase;
          "
        >Contacto</p>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0;">
          <li>
            <a
              href="mailto:camandrefactory@gmail.com"
              class="cf-tap"
              style="color: var(--cf-brand); text-decoration: none; font-size: 14px;"
            >camandrefactory@gmail.com</a>
          </li>
          <li>
            <address
              style="
                font-style: normal;
                font-size: 14px;
                color: var(--cf-dark-dim);
                line-height: 1.5;
              "
            >
              Chía, Cundinamarca · Colombia
            </address>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      style="
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 28px;
        flex-wrap: wrap;
        gap: 16px;
      "
    >
      <p style="margin: 0; font-size: 13px; color: var(--cf-dark-dim);">
        © Camandre Factory · {COPYRIGHT_RANGE} · Todos los derechos reservados
      </p>
      {/*
        Privacidad and Términos used to sit here pointing at href="#". A link
        that promises a page and delivers nothing costs more trust than the
        absence of the link. The site collects nothing to disclose anyway: no
        forms, no cookies, no analytics, no third-party requests — only a
        localStorage key holding the theme. Bring them back as real routes.
      */}
    </div>
  </div>
</footer>
