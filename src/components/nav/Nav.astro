---
import ThemeToggle from '../shared/ThemeToggle.astro';
import Logo from '../shared/Logo.astro';

interface Props {
  activePage?: string;
}

const { activePage = '' } = Astro.props;

const links = [
  { label: 'Servicios', href: '/servicios', key: 'servicios' },
  { label: 'Portafolio', href: '/portafolio', key: 'portafolio' },
  { label: 'Nosotros', href: '/nosotros', key: 'nosotros' },
];
---

<header
  style="
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--cf-nav-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--cf-rule);
  "
>
  <div class="px-5 md:px-10"
    style="
      max-width: 1240px;
      margin: 0 auto;
      padding-top: 18px;
      padding-bottom: 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    "
  >
    <!-- Logo -->
    <Logo />

    <!-- Nav links (center) — hidden on mobile, visible md+ -->
    <nav aria-label="Navegación principal" class="hidden md:flex" style="gap: 32px; align-items: center;">
      {links.map((link) => (
        <a
          href={link.href}
          class="cf-navlink cf-tap"
          data-active={activePage === link.key ? 'true' : 'false'}
          style="
            font-size: 15px;
            font-weight: 500;
            color: var(--cf-text);
            text-decoration: none;
          "
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right: ThemeToggle + CTA (desktop) -->
    <div class="hidden md:flex" style="align-items: center; gap: 12px; flex-shrink: 0;">
      <ThemeToggle />
      <a
        href="#contacto"
        class="cf-btn"
        style="
          background: var(--cf-navy);
          color: #ffffff;
          padding: 13px 22px;
          border-radius: 8px;
          
          font-size: 14px;
          font-weight: 600;
          text-decoration: none;
          white-space: nowrap;
        "
      >
        Conversemos
      </a>
    </div>

    <!-- Hamburger button — visible only on mobile (<md) -->
    <button
      id="cf-nav-toggle"
      aria-expanded="false"
      aria-controls="cf-nav-drawer"
      aria-label="Abrir menú de navegación"
      class="flex items-center justify-center flex-shrink-0 md:hidden"
      class="cf-tap-icon"
      style="
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
        color: var(--cf-text);
      "
    >
      <!-- Hamburger icon -->
      <svg id="cf-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <!-- Close icon -->
      <svg id="cf-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="display: none;">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>
</header>

<!-- Overlay behind drawer -->
<div
  id="cf-nav-overlay"
  data-open="false"
  aria-hidden="true"
  style="
    position: fixed;
    inset: 0;
    z-index: 45;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  "
></div>

<!-- Drawer panel -->
<div
  id="cf-nav-drawer"
  data-open="false"
  aria-hidden="true"
  inert
  style="
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    width: min(320px, 85vw);
    /* Opaque on purpose. --cf-nav-bg is a translucent token built for the
       sticky bar, which pairs it with backdrop-filter: blur(14px). The drawer
       has no blur, so the same value just let the page read through the menu:
       0.82 alpha in dark, 0.85 in light, both unreadable over the hero. */
    background: var(--cf-paper);
    border-left: 1px solid var(--cf-rule);
    display: flex;
    flex-direction: column;
    padding: 24px 20px;
    gap: 32px;
    transform: translateX(100%);
    transition: transform 0.25s ease;
    overflow-y: auto;
  "
>
  <!-- Drawer header: close button -->
  <div style="display: flex; justify-content: flex-end;">
    <button
      id="cf-drawer-close"
      aria-label="Cerrar menú de navegación"
      class="cf-tap-icon"
      style="
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
        color: var(--cf-text);
        display: flex;
        align-items: center;
        justify-content: center;
      "
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Drawer nav links -->
  <nav aria-label="Navegación mobile" style="display: flex; flex-direction: column; gap: 4px;">
    {links.map((link) => (
      <a
        href={link.href}
        class="cf-drawer-link cf-navlink cf-tap"
        data-active={activePage === link.key ? 'true' : 'false'}
        style="
          font-size: 18px;
          font-weight: 500;
          color: var(--cf-text);
          text-decoration: none;
          padding: 12px 8px;
          border-radius: 6px;
          display: block;
        "
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Drawer controls: ThemeToggle + CTA -->
  <div style="display: flex; flex-direction: column; gap: 16px; margin-top: auto;">
    <div style="display: flex; align-items: center; gap: 12px;">
      <ThemeToggle />
    </div>
    <a
      href="#contacto"
      class="cf-btn cf-drawer-link"
      style="
        background: var(--cf-navy);
        color: #ffffff;
        padding: 14px 22px;
        border-radius: 8px;
        
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
        display: block;
      "
    >
      Conversemos
    </a>
  </div>
</div>

<script is:inline>
  (function () {
    var toggle = document.getElementById('cf-nav-toggle');
    var drawer = document.getElementById('cf-nav-drawer');
    var overlay = document.getElementById('cf-nav-overlay');
    var drawerClose = document.getElementById('cf-drawer-close');
    var iconOpen = document.getElementById('cf-icon-open');
    var iconClose = document.getElementById('cf-icon-close');

    if (!toggle || !drawer || !overlay) return;

    var isOpen = false;

    function openDrawer() {
      isOpen = true;
      drawer.style.transform = 'translateX(0)';
      drawer.setAttribute('data-open', 'true');
      drawer.setAttribute('aria-hidden', 'false');
      drawer.removeAttribute('inert');
      overlay.style.opacity = '1';
      overlay.style.pointerEvents = 'auto';
      overlay.setAttribute('data-open', 'true');
      overlay.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'true');
      if (iconOpen) iconOpen.style.display = 'none';
      if (iconClose) iconClose.style.display = 'block';
      document.body.style.overflow = 'hidden';
      // Focus first link in drawer
      var firstLink = drawer.querySelector('a, button');
      if (firstLink) firstLink.focus();
    }

    function closeDrawer() {
      isOpen = false;
      drawer.style.transform = 'translateX(100%)';
      drawer.setAttribute('data-open', 'false');
      drawer.setAttribute('aria-hidden', 'true');
      // inert removes the panel from the tab order and the accessibility tree.
      // Without it the drawer keeps its focusable children while hidden, which
      // is what made aria-hidden="true" sit on top of tabbable links — and it
      // stayed reachable on desktop, where the drawer never appears at all.
      drawer.setAttribute('inert', '');
      overlay.style.opacity = '0';
      overlay.style.pointerEvents = 'none';
      overlay.setAttribute('data-open', 'false');
      toggle.setAttribute('aria-expanded', 'false');
      if (iconOpen) iconOpen.style.display = 'block';
      if (iconClose) iconClose.style.display = 'none';
      document.body.style.overflow = '';
      toggle.focus();
    }

    toggle.addEventListener('click', function () {
      if (isOpen) { closeDrawer(); } else { openDrawer(); }
    });

    if (drawerClose) {
      drawerClose.addEventListener('click', closeDrawer);
    }

    overlay.addEventListener('click', closeDrawer);

    var FOCUSABLE = 'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

    document.addEventListener('keydown', function (e) {
      if (!isOpen) return;

      if (e.key === 'Escape') { closeDrawer(); return; }

      // Keep Tab inside the panel. An open drawer covers the page, so letting
      // focus walk behind it strands the keyboard on controls nobody can see.
      if (e.key !== 'Tab') return;
      var items = Array.prototype.filter.call(
        drawer.querySelectorAll(FOCUSABLE),
        function (el) { return el.offsetParent !== null; }
      );
      if (!items.length) return;

      var first = items[0];
      var last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    var drawerLinks = drawer.querySelectorAll('.cf-drawer-link');
    drawerLinks.forEach(function (link) {
      link.addEventListener('click', closeDrawer);
    });
  })();
</script>
