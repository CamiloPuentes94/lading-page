---
import '../styles/global.css';
import Nav from '../components/nav/Nav.astro';
import Footer from '../components/footer/Footer.astro';
import geistSans400 from '@fontsource/geist-sans/files/geist-sans-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
  /** Page-specific social share image, relative to the site root. */
  ogImage?: string;
  /** Keep the page out of search results (thank-you pages, dead ends). */
  noindex?: boolean;
}

const {
  title,
  description = "Camandre Factory - Soluciones de software a medida",
  activePage = "",
  ogImage = "/og-default.png",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const organization = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Camandre Factory",
  description,
  url: Astro.site?.href,
  logo: new URL("/favicon.svg", Astro.site).href,
  image: ogImageUrl.href,
  email: "camandrefactory@gmail.com",
  telephone: "+573134212476",
  foundingDate: "2024",
  priceRange: "$$",
  areaServed: "CO",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Chía",
    addressRegion: "Cundinamarca",
    addressCountry: "CO",
  },
  knowsAbout: [
    "Desarrollo de software a medida",
    "Sistemas POS",
    "Infraestructura y DevOps",
    "Consultoría técnica",
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={geistSans400}
      crossorigin="anonymous"
    />

    <!-- Anti-FOUC: runs synchronously before first paint -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('cf-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (t === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Camandre Factory" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Camandre Factory — software a medida" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organization)}
    />
  </head>
  <body class="bg-[var(--cf-bg)] text-[var(--cf-text)] min-h-screen flex flex-col overflow-x-hidden">
    <Nav activePage={activePage} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- IntersectionObserver global for .cf-reveal elements -->
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('js-loaded');
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px -5% 0px' }
        );
        document.querySelectorAll('[data-cf-reveal]').forEach(function (el) {
          io.observe(el);
        });
        // Also observe elements added dynamically (e.g. after Astro hydration)
        var mo = new MutationObserver(function (mutations) {
          mutations.forEach(function (m) {
            m.addedNodes.forEach(function (node) {
              if (node.nodeType !== 1) return;
              if (node.hasAttribute && node.hasAttribute('data-cf-reveal')) io.observe(node);
              node.querySelectorAll && node.querySelectorAll('[data-cf-reveal]').forEach(function (el) {
                io.observe(el);
              });
            });
          });
        });
        mo.observe(document.body, { childList: true, subtree: true });
      })();
    </script>
  </body>
</html>
