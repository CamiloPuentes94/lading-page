---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="¡Gracias! — Camandre Factory"
  description="Tu mensaje fue recibido. Te contactamos pronto."
  noindex
>
  <section style="
    min-height: calc(100vh - 72px - 300px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 32px;
    background: var(--cf-bg);
    text-align: center;
  ">
    <div style="max-width: 520px;">
      <!-- Checkmark icon -->
      <div style="
        width: 72px; height: 72px;
        border-radius: 50%;
        background: rgba(14,164,114,0.12);
        border: 2px solid rgba(14,164,114,0.3);
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 32px;
        font-size: 32px;
      ">✓</div>

      <h1 style="
        font-size: clamp(32px, 5vw, 52px);
        font-weight: 600;
        letter-spacing: -0.04em;
        color: var(--cf-ink);
        margin: 0 0 16px;
        line-height: 1.1;
      ">
        ¡Ya estás dentro!
      </h1>

      <p style="
        font-size: 17px;
        color: var(--cf-dim);
        line-height: 1.65;
        margin: 0 0 40px;
      ">
        Recibimos tu mensaje. Te contactamos en las próximas 24 horas para coordinar una conversación.
      </p>

      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a
          href="/"
          class="cf-btn"
          style="
            padding: 12px 24px;
            background: var(--cf-navy);
            color: white;
            border-radius: 8px;
            
            font-size: 14px;
            font-weight: 600;
            display: inline-block;
            box-shadow: 0 4px 14px rgba(15,37,87,0.2);
          "
        >
          Volver al inicio
        </a>
        <a
          href="/portafolio/"
          class="cf-btn"
          style="
            padding: 12px 24px;
            background: transparent;
            color: var(--cf-ink);
            border: 1.5px solid var(--cf-rule);
            border-radius: 8px;
            
            font-size: 14px;
            font-weight: 500;
            display: inline-block;
          "
        >
          Ver portafolio →
        </a>
      </div>

      <p style="
        margin-top: 40px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: var(--cf-dim);
      ">
        O escribinos directo a <a href="mailto:camandrefactory@gmail.com" style="color: var(--cf-brand);">camandrefactory@gmail.com</a>
      </p>
    </div>
  </section>
</Layout>
