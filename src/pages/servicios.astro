---
import Layout from '../layouts/Layout.astro';
import Section from '../components/shared/Section.astro';
import SectionHeader from '../components/shared/SectionHeader.astro';
import PageHero from '../components/shared/PageHero.astro';
import ClosingCTA from '../components/shared/ClosingCTA.astro';
import MetricCard from '../components/shared/MetricCard.astro';

/**
 * One Service graph per discipline, each anchored to the section that
 * describes it so the URL a result links to is the one the reader wants.
 */
const DISCIPLINES = [
  ['producto', 'Desarrollo de producto web a medida', 'Aplicaciones web modernas: SaaS, dashboards, portales y plataformas internas, construidas para que el equipo del cliente pueda mantenerlas.'],
  ['sistemas', 'Sistemas internos a medida', 'Software interno que reemplaza hojas de cálculo y procesos manuales en operaciones que ya no escalan.'],
  ['infra', 'Infraestructura y DevOps', 'Despliegue, observabilidad, CI/CD y operación de la infraestructura que sostiene el producto en producción.'],
  ['consultoria', 'Consultoría técnica', 'Auditoría de arquitectura, revisión de código y acompañamiento a equipos que necesitan una segunda opinión con evidencia.'],
];

const services = DISCIPLINES.map(([anchor, name, description]) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name,
  description,
  serviceType: name,
  url: `https://camandrefactory.com/servicios/#${anchor}`,
  areaServed: { '@type': 'Country', name: 'Colombia' },
  provider: {
    '@type': 'ProfessionalService',
    name: 'Camandre Factory',
    url: 'https://camandrefactory.com/',
  },
}));
---

<Layout
  title="Servicios — Software a medida para pymes | Camandre Factory"
  description="Desarrollo de producto, sistemas internos, infraestructura y consultoría técnica para pymes colombianas. Contratas por proyecto, por equipo o por retainer."
  activePage="servicios"
  ogImage="/og-servicios.png"
  schema={services}
>

  <!-- ═══════════════════════════════════════════════════════════
       SERVICES HERO
  ════════════════════════════════════════════════════════════ -->
  <PageHero eyebrow="Oficios · 4 disciplinas" contentWidth="880px">
    <h1 style="
      font-size: clamp(40px, 8vw, 96px);
      font-weight: 600;
      letter-spacing: -0.04em;
      line-height: 0.98;
      color: var(--cf-ink);
      margin: 24px 0 0;
      text-wrap: balance;
    ">
      Diseño, ingeniería e infraestructura,<br />
      <span style="color: var(--cf-dim);">bajo el mismo techo.</span>
    </h1>
    <p style="
      font-size: 19px;
      line-height: 1.6;
      color: var(--cf-dim);
      margin-top: 32px;
      max-width: 640px;
    ">
      Cuatro oficios complementarios, un solo equipo. Sin subcontratación, sin handoffs,
      sin gerentes intermediarios: para tu pyme eso significa un solo interlocutor, y que el mismo
      equipo que arquitecta el sistema es el que lo mantiene en producción.
    </p>
  </PageHero>

  <!-- ═══════════════════════════════════════════════════════════
       BLOCK 01 — PRODUCTO (paper bg, normal order)
  ════════════════════════════════════════════════════════════ -->
  <Section id="producto" surface="paper" rule="bottom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center">

        <!-- Mock — order 1 -->
        <div
          class="cf-reveal"
          data-cf-reveal
          style="order: 1;"
        >
          <!-- MockProducto -->
          <div style="
            background: var(--cf-navy-deep);
            border-radius: 14px;
            padding: 22px;
            border: 1px solid var(--cf-dark-border);
            box-shadow: 0 30px 80px -40px rgba(11,19,43,0.4);
          ">
            <!-- Titlebar -->
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
              <span style="width: 9px; height: 9px; border-radius: 5px; background: #FF5F56; display: inline-block;"></span>
              <span style="width: 9px; height: 9px; border-radius: 5px; background: #FFBD2E; display: inline-block;"></span>
              <span style="width: 9px; height: 9px; border-radius: 5px; background: #27C93F; display: inline-block;"></span>
              <span style="flex: 1; text-align: center; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--cf-dark-faint);">app.northwind.co · dashboard</span>
            </div>
            <!-- Metrics grid -->
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
              <MetricCard label="MRR"             value="$284K" delta="+12.4%"   spark="rise" />
              <MetricCard label="Cuentas activas" value="1,247" delta="+38"      spark="wave" />
              <MetricCard label="NPS"             value="64"    delta="+8 vs Q1" spark="rise" />
              <MetricCard label="Churn 90d"       value="2.1%"  delta="−0.4 pt"  spark="wave" />
            </div>
          </div>
        </div>

        <!-- Body — order 2 -->
        <div
          class="cf-reveal"
          data-cf-reveal
          style="order: 2;"
        >
          <!-- Tag + oficio label -->
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 22px;">
            <span style="
              font-family: 'JetBrains Mono', monospace; font-size: 12px;
              color: var(--cf-brand); letter-spacing: 0.16em;
              padding: 5px 12px;
              background: rgba(14,164,114,0.094);
              border-radius: 4px;
            ">PRODUCTO</span>
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--cf-dim); letter-spacing: 0.12em;">OFICIO 01 / 04</span>
          </div>

          <h2 style="
            font-size: clamp(28px, 4.5vw, 56px); font-weight: 600;
            letter-spacing: -0.035em;
            color: var(--cf-ink);
            margin: 0; line-height: 1;
            text-wrap: balance;
          ">Producto web a medida.</h2>

          <p style="font-size: 18px; line-height: 1.6; color: var(--cf-text); margin: 24px 0 0; max-width: 560px;">
            Aplicaciones web modernas: SaaS, dashboards, portales, plataformas internas. Stack que sobrevive a las modas y que tu equipo puede mantener sin nosotros.
          </p>

          <!-- Includes -->
          <div style="margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--cf-rule);">
            <div class="font-mono uppercase text-[11px] tracking-[0.14em] text-cf-brand mb-4">Incluye</div>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-y-[10px] gap-x-6" style="list-style: none; padding: 0; margin: 0;">
              {['Investigación + diseño de producto', 'Sistema de UI propio', 'Frontend con Astro / React', 'Backend con TypeScript o Go', 'SEO técnico + Core Web Vitals', 'Accesibilidad WCAG 2.2 AA'].map((item) => (
                <li style="display: flex; align-items: flex-start; gap: 10px; font-size: 14.5px; color: var(--cf-text); line-height: 1.5;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--cf-brand)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 4px;">
                    <path d="M4 12 L10 18 L20 6" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Deliverables + Stack -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6" style="margin-top: 28px;">
            <div>
              <div class="font-mono uppercase text-[10.5px] tracking-[0.14em] text-cf-dim mb-2">Entregables</div>
              <div style="font-size: 14.5px; color: var(--cf-text);">Producto en producción + repo + sistema de diseño + documentación viva</div>
            </div>
            <div>
              <div class="font-mono uppercase text-[10.5px] tracking-[0.14em] text-cf-dim mb-2">Stack típico</div>
              <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                {['Astro', 'React', 'TypeScript', 'Tailwind', 'shadcn/ui', 'Go', 'Postgres'].map((s) => (
                  <span style="font-family: 'JetBrains Mono', monospace; font-size: 11.5px; padding: 4px 10px; background: var(--cf-bg2); color: var(--cf-ink); border-radius: 4px;">{s}</span>
                ))}
              </div>
            </div>
          </div>
        </div>

      </div>
  </Section>

  <!-- ═══════════════════════════════════════════════════════════
       BLOCK 02 — SISTEMAS (bg, reverse order)
  ════════════════════════════════════════════════════════════ -->
  <Section id="sistemas" rule="bottom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center">

        <!-- Body — order 1 (reverse) -->
        <div
          class="cf-reveal"
          data-cf-reveal
          style="order: 1;"
        >
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 22px;">
            <span style="
              font-family: 'JetBrains Mono', monospace; font-size: 12px;
              color: var(--cf-brand); letter-spacing: 0.16em;
              padding: 5px 12px;
              background: rgba(14,164,114,0.094);
              border-radius: 4px;
            ">SISTEMAS</span>
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--cf-dim); letter-spacing: 0.12em;">OFICIO 02 / 04</span>
          </div>

          <h2 style="
            font-size: clamp(28px, 4.5vw, 56px); font-weight: 600;
            letter-spacing: -0.035em;
            color: var(--cf-ink);
            margin: 0; line-height: 1;
            text-wrap: balance;
          ">Sistemas a medida.</h2>

          <p style="font-size: 18px; line-height: 1.6; color: var(--cf-text); margin: 24px 0 0; max-width: 560px;">
            ERPs, CRMs, operaciones internas, herramientas de soporte. Modelamos tu negocio en software para que tu equipo deje de depender de hojas de cálculo y reuniones.
          </p>

          <div style="margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--cf-rule);">
            <div class="font-mono uppercase text-[11px] tracking-[0.14em] text-cf-brand mb-4">Incluye</div>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-y-[10px] gap-x-6" style="list-style: none; padding: 0; margin: 0;">
              {['Modelado de dominio del negocio', 'Migración desde sistemas legacy', 'Permisos y trazabilidad finos', 'Reportería en tiempo real', 'Integraciones (SAP, Siesa, Stripe)', 'Capacitación a tu equipo'].map((item) => (
                <li style="display: flex; align-items: flex-start; gap: 10px; font-size: 14.5px; color: var(--cf-text); line-height: 1.5;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--cf-brand)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 4px;">
                    <path d="M4 12 L10 18 L20 6" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6" style="margin-top: 28px;">
            <div>
              <div class="font-mono uppercase text-[10.5px] tracking-[0.14em] text-cf-dim mb-2">Entregables</div>
              <div style="font-size: 14.5px; color: var(--cf-text);">Sistema en producción + integraciones + onboarding · 90+ días de soporte</div>
            </div>
            <div>
              <div class="font-mono uppercase text-[10.5px] tracking-[0.14em] text-cf-dim mb-2">Stack típico</div>
              <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                {['Django', 'FastAPI', 'Go', 'PostgreSQL', 'Redis', 'Celery', 'Docker', 'Grafana'].map((s) => (
                  <span style="font-family: 'JetBrains Mono', monospace; font-size: 11.5px; padding: 4px 10px; background: var(--cf-bg2); color: var(--cf-ink); border-radius: 4px;">{s}</span>
                ))}
              </div>
              <div style="margin-top: 28px;">
                <a
                  class="cf-tap"
                  href="https://pos.camandrefactory.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  style="font-size: 14px; font-weight: 600; color: var(--cf-brand); text-decoration: none; display: inline-flex; align-items: center; gap: 6px;"
                >Ver Sistema POS en vivo →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Mock — order 2 (reverse) -->
        <div
          class="cf-reveal"
          data-cf-reveal
          style="order: 2;"
        >
          <!-- MockSistemas -->
          <div style="
            background: var(--cf-paper);
            border-radius: 14px; padding: 24px;
            border: 1px solid var(--cf-rule);
            box-shadow: var(--cf-shadow-md);
          ">
            <!-- Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--cf-rule);">
              <div>
                <div style="font-size: 14px; font-weight: 600; color: var(--cf-ink);">Bitácora de operación</div>
                <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--cf-dim); margin-top: 2px;">ERP · módulo logística · sucursal: todas</div>
              </div>
              <span style="
                display: inline-flex; align-items: center; gap: 8px;
                padding: 4px 10px;
                font-family: 'JetBrains Mono', monospace; font-size: 11px;
                color: var(--cf-brand);
                background: rgba(14,164,114,0.094);
                border-radius: 4px;
              ">● en vivo</span>
            </div>
            <!-- Column headers -->
            <div style="display: grid; grid-template-columns: 110px 1fr 70px 60px; gap: 12px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--cf-dim); padding-bottom: 8px;">
              <span>CÓDIGO</span><span>EVENTO</span><span>HORA</span><span>EST</span>
            </div>
            <!-- Rows -->
            {[
              { c: 'ACME-0421', t: 'Pedido recibido', e: '14:02', s: 'OK' },
              { c: 'ACME-0422', t: 'En picking · Sede Norte', e: '14:04', s: 'OK' },
              { c: 'ACME-0423', t: 'Stock bajo · alerta enviada', e: '14:07', s: 'WARN' },
              { c: 'ACME-0424', t: 'Despachado', e: '14:09', s: 'OK' },
              { c: 'ACME-0425', t: 'En picking · Sede Sur', e: '14:11', s: 'OK' },
            ].map((r) => (
              <div style={`display: grid; grid-template-columns: 110px 1fr 70px 60px; gap: 12px; padding: 10px 0; border-top: 1px solid var(--cf-rule); font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--cf-text);`}>
                <span style="font-weight: 600;">{r.c}</span>
                <span style="color: var(--cf-text);">{r.t}</span>
                <span style="color: var(--cf-dim);">{r.e}</span>
                <span style={`color: ${r.s === 'OK' ? 'var(--cf-brand)' : '#C28419'}; font-weight: 600;`}>{r.s}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
  </Section>

  <!-- ═══════════════════════════════════════════════════════════
       BLOCK 03 — INFRAESTRUCTURA (paper bg, normal order)
  ════════════════════════════════════════════════════════════ -->
  <Section id="infra" surface="paper" rule="bottom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center">

        <!-- Mock — order 1 -->
        <div
          class="cf-reveal"
          data-cf-reveal
          style="order: 1;"
        >
          <!-- MockInfra -->
          <div style="
            background: var(--cf-navy-deep);
            border-radius: 14px; padding: 24px;
            border: 1px solid var(--cf-dark-border);
          ">
            <div style="display: flex; justify-content: space-between; margin-bottom: 18px;">
              <div style="font-size: 14px; font-weight: 600; color: #FFFFFF;">Plataforma · panorama</div>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--cf-brand);">● healthy</span>
            </div>
            <!-- Node diagram -->
            <div style="position: relative; height: 220px; background: #070C20; border-radius: 10px; border: 1px solid var(--cf-dark-border); overflow: hidden;">
              <svg width="100%" height="100%" viewBox="0 0 400 220" style="position: absolute; inset: 0;">
                <defs>
                  <pattern id="infra-dots" width="16" height="16" patternUnits="userSpaceOnUse">
                    <circle cx="2" cy="2" r="1" fill="var(--cf-dark-border)" />
                  </pattern>
                </defs>
                <rect width="400" height="220" fill="url(#infra-dots)" />
                <line x1="100" y1="60" x2="200" y2="110" stroke="var(--cf-brand)" stroke-width="1.5" opacity="0.6" />
                <line x1="300" y1="60" x2="200" y2="110" stroke="var(--cf-brand)" stroke-width="1.5" opacity="0.6" />
                <line x1="200" y1="110" x2="120" y2="170" stroke="var(--cf-brand)" stroke-width="1.5" opacity="0.6" />
                <line x1="200" y1="110" x2="280" y2="170" stroke="var(--cf-brand)" stroke-width="1.5" opacity="0.6" />
              </svg>
              <!-- Nodes -->
              <div style="position: absolute; left: 68px; top: 44px; width: 64px; height: 32px; background: var(--cf-dark-surface); border: 1px solid var(--cf-brand); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #FFFFFF; letter-spacing: 0.08em;">API</div>
              <div style="position: absolute; left: 268px; top: 44px; width: 64px; height: 32px; background: var(--cf-dark-surface); border: 1px solid var(--cf-brand); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #FFFFFF; letter-spacing: 0.08em;">WEB</div>
              <div style="position: absolute; left: 168px; top: 94px; width: 64px; height: 32px; background: var(--cf-dark-surface); border: 1px solid #FFBD2E; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #FFFFFF; letter-spacing: 0.08em;">GATEWAY</div>
              <div style="position: absolute; left: 88px; top: 154px; width: 64px; height: 32px; background: var(--cf-dark-surface); border: 1px solid var(--cf-brand); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #FFFFFF; letter-spacing: 0.08em;">DB</div>
              <div style="position: absolute; left: 248px; top: 154px; width: 64px; height: 32px; background: var(--cf-dark-surface); border: 1px solid var(--cf-brand); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #FFFFFF; letter-spacing: 0.08em;">CACHE</div>
            </div>
            <!-- Stats -->
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 14px;">
              <div style="background: var(--cf-dark-surface); border-radius: 8px; padding: 12px 14px; border: 1px solid var(--cf-dark-border);">
                <div style="font-size: 20px; font-weight: 600; color: #FFFFFF; letter-spacing: -0.02em;">99.98%</div>
                <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--cf-dark-faint); letter-spacing: 0.1em; margin-top: 2px;">UPTIME 90D</div>
              </div>
              <div style="background: var(--cf-dark-surface); border-radius: 8px; padding: 12px 14px; border: 1px solid var(--cf-dark-border);">
                <div style="font-size: 20px; font-weight: 600; color: #FFFFFF; letter-spacing: -0.02em;">184ms</div>
                <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--cf-dark-faint); letter-spacing: 0.1em; margin-top: 2px;">p95 LATENCY</div>
              </div>
              <div style="background: var(--cf-dark-surface); border-radius: 8px; padding: 12px 14px; border: 1px solid var(--cf-dark-border);">
                <div style="font-size: 20px; font-weight: 600; color: #FFFFFF; letter-spacing: -0.02em;">0</div>
                <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--cf-dark-faint); letter-spacing: 0.1em; margin-top: 2px;">INCIDENTES Q2</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Body — order 2 -->
        <div
          class="cf-reveal"
          data-cf-reveal
          style="order: 2;"
        >
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 22px;">
            <span style="
              font-family: 'JetBrains Mono', monospace; font-size: 12px;
              color: var(--cf-brand); letter-spacing: 0.16em;
              padding: 5px 12px;
              background: rgba(14,164,114,0.094);
              border-radius: 4px;
            ">INFRAESTRUCTURA</span>
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--cf-dim); letter-spacing: 0.12em;">OFICIO 03 / 04</span>
          </div>

          <h2 style="
            font-size: clamp(28px, 4.5vw, 56px); font-weight: 600;
            letter-spacing: -0.035em;
            color: var(--cf-ink);
            margin: 0; line-height: 1;
            text-wrap: balance;
          ">Infraestructura &amp; Cloud.</h2>

          <p style="font-size: 18px; line-height: 1.6; color: var(--cf-text); margin: 24px 0 0; max-width: 560px;">
            La plataforma técnica que se vuelve invisible cuando funciona. Migración serverless, infraestructura como código, observabilidad y on-call cuando lo necesites.
          </p>

          <div style="margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--cf-rule);">
            <div class="font-mono uppercase text-[11px] tracking-[0.14em] text-cf-brand mb-4">Incluye</div>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-y-[10px] gap-x-6" style="list-style: none; padding: 0; margin: 0;">
              {['Auditoría de infraestructura actual', 'Diseño de arquitectura cloud', 'Migración por fases con canary', 'IaC con Terraform / Pulumi', 'Observabilidad: logs, métricas, tracing', 'Plan de respuesta a incidentes'].map((item) => (
                <li style="display: flex; align-items: flex-start; gap: 10px; font-size: 14.5px; color: var(--cf-text); line-height: 1.5;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--cf-brand)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 4px;">
                    <path d="M4 12 L10 18 L20 6" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6" style="margin-top: 28px;">
            <div>
              <div class="font-mono uppercase text-[10.5px] tracking-[0.14em] text-cf-dim mb-2">Entregables</div>
              <div style="font-size: 14.5px; color: var(--cf-text);">Infraestructura productiva + IaC + runbooks + SLOs documentados</div>
            </div>
            <div>
              <div class="font-mono uppercase text-[10.5px] tracking-[0.14em] text-cf-dim mb-2">Stack típico</div>
              <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                {['GCP', 'AWS', 'Terraform', 'Kubernetes', 'Grafana', 'Datadog'].map((s) => (
