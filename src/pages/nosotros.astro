---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/shared/Eyebrow.astro';
import Section from '../components/shared/Section.astro';
import Button from '../components/shared/Button.astro';
import SectionHeader from '../components/shared/SectionHeader.astro';
import PageHero from '../components/shared/PageHero.astro';
import ClosingCTA from '../components/shared/ClosingCTA.astro';

const timeline = [
  { y: '2024', t: 'Dos personas, una idea en Chía, Cundinamarca' },
  { y: '2024', t: 'Primer cliente real: Sinerlly — sistema POS en producción' },
  { y: '2025', t: 'Falcon Precision — dos aplicaciones internas para el estado' },
];

const values = [
  {
    n: '01',
    t: 'Decir no es un acto de respeto',
    d: 'Rechazamos al menos dos de cada tres proyectos que tocan la puerta. No por elitismo: porque sabemos que un equipo distraído entrega trabajo mediocre. Si no podemos comprometernos plenamente, te lo decimos en la primera llamada.',
  },
  {
    n: '02',
    t: 'El código que entregamos vive sin nosotros',
    d: 'Documentación viva. Tests significativos. Decisiones de arquitectura registradas en ADRs. Si decides dejarnos, tu equipo entiende el sistema en una semana. Ese es el estándar.',
  },
  {
    n: '03',
    t: 'Lo aburrido sostiene lo brillante',
    d: 'Observabilidad, seguridad, accesibilidad, performance. Las cosas que nadie celebra en demos pero que son la diferencia entre un producto que dura y uno que se cae el día del lanzamiento.',
  },
  {
    n: '04',
    t: 'Honestidad técnica sobre cortesía social',
    d: 'Si una decisión nos parece equivocada —la tuya o la nuestra— lo decimos. No envolvemos en eufemismos. La cortesía cuesta proyectos a tres años; la honestidad los rescata.',
  },
];

const team = [
  { initials: 'JC', name: 'Juan Camilo Puentes Sandoval', role: 'Desarrollador · Fundador',       city: 'Chía', bio: 'Construye sistemas desde cero. Full-stack con foco en arquitectura limpia y sistemas que escalan sin drama.', color: '#0F2557' },
  { initials: 'YA', name: 'Yuri Andrea Cervera Lozano',   role: 'Diseñadora UI/UX · Cofundadora', city: 'Chía', bio: 'Diseña interfaces que los usuarios entienden sin manual. Lidera pruebas y asegura que cada entrega se vea y funcione bien.', color: '#0EA472' },
];

const locations = [
  { city: 'Chía',  country: 'Colombia', addr: 'Cundinamarca', count: '2 personas',  primary: true  },
];

---

<Layout
  title="Nosotros — Camandre Factory"
  description="Fundada en 2024 en Chía, Cundinamarca. Quiénes somos, cómo trabajamos y por qué construimos software que se pueda mantener después de que nos vamos."
  activePage="nosotros"
>

  <!-- ═══════════════════════════════════════════════════════════
       HERO
  ════════════════════════════════════════════════════════════ -->
  <PageHero eyebrow="Nosotros · Camandre Factory" contentWidth="980px">
    <h1 style="
      font-size: clamp(40px, 8vw, 96px);
      font-weight: 600;
      letter-spacing: -0.04em;
      line-height: 0.98;
      color: var(--cf-ink);
      margin: 24px 0 0;
      text-wrap: balance;
    ">
      Una fábrica pequeña.<br />
      <span style="color: var(--cf-dim);">Decisiones grandes.</span>
    </h1>
    <p style="font-size: 19px; line-height: 1.6; color: var(--cf-dim); margin-top: 32px; max-width: 700px;">
      Somos Juan Camilo y Yuri Andrea, dos personas en Chía, Colombia, que decidieron que el mundo no
      necesitaba otra agencia que dijera sí a todo. Necesitaba un equipo que dijera no cuando hace falta.
    </p>
  </PageHero>

  <!-- ═══════════════════════════════════════════════════════════
       ORIGIN — Timeline
  ════════════════════════════════════════════════════════════ -->
  <Section surface="paper" rule="bottom">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-10 lg:gap-20 items-start">

        <!-- Left: eyebrow + h2 + timeline -->
        <div class="cf-reveal" data-cf-reveal>
          <Eyebrow>Origen</Eyebrow>
          <h2 style="
            font-size: clamp(28px, 4.5vw, 56px);
            font-weight: 600;
            letter-spacing: -0.035em;
            color: var(--cf-ink);
            margin: 22px 0 0;
            line-height: 1;
          ">
            Cómo<br />empezó esto.
          </h2>
          <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--cf-rule); display: flex; flex-direction: column; gap: 16px;">
            {timeline.map((m) => (
              <div style="display: grid; grid-template-columns: 60px 1fr; gap: 20px; padding: 4px 0;">
                <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--cf-brand); font-weight: 600; letter-spacing: 0.05em;">{m.y}</span>
                <span style="font-size: 14.5px; color: var(--cf-text);">{m.t}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: prose -->
        <div class="cf-reveal" data-cf-reveal>
          <p style="font-size: 22px; line-height: 1.55; color: var(--cf-ink); margin: 0; font-weight: 500; letter-spacing: -0.012em;">
            Camandre nació en 2024 cuando dos personas se cansaron del mismo guion: agencias que prometían
            transformación digital y entregaban sitios con tres meses de retraso.
          </p>
          <p style="font-size: 17px; line-height: 1.7; color: var(--cf-text); margin-top: 24px;">
            Empezamos con una idea simple: trabajar con pocos clientes a la vez, dedicarles atención real, y
            cobrar por el valor que entregamos en producción —no por las horas que pasamos en reuniones. Un
            año después, esa idea sigue siendo el contrato implícito con cada cliente nuevo.
          </p>
          <p style="font-size: 17px; line-height: 1.7; color: var(--cf-text); margin-top: 18px;">
            Hoy somos dos personas. Tomamos los proyectos que podemos hacer bien. No vamos a crecer sin control:
            nuestra ventaja competitiva es exactamente lo opuesto a escalar a cualquier costo.
          </p>
          <p style="font-size: 17px; line-height: 1.7; color: var(--cf-text); margin-top: 18px;">
            No subcontratamos. No reciclamos código de otros clientes. No prometemos lo que no podemos sostener.
            Es una manera lenta de crecer y, hasta ahora, también la única que nos deja dormir tranquilos.
          </p>
        </div>

      </div>
  </Section>

  <!-- ═══════════════════════════════════════════════════════════
       VALUES — Cuatro principios
  ════════════════════════════════════════════════════════════ -->
  <Section>
      <SectionHeader
        eyebrow="Cómo trabajamos"
        title="Cuatro principios. Negociables solo entre nosotros."
        lede="No son frases de pared. Son los criterios concretos con los que tomamos decisiones cuando un cliente nos pide algo que no deberíamos hacer."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2" style="gap: 1px; background: var(--cf-rule); border: 1px solid var(--cf-rule); border-radius: 14px; overflow: hidden;">
        {values.map((v) => (
          <div
            class="cf-reveal"
            data-cf-reveal
            style="background: var(--cf-paper); padding: 40px 36px; min-height: 240px; display: flex; flex-direction: column; gap: 16px;"
          >
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--cf-brand); letter-spacing: 0.14em;">{v.n}</span>
              <span style="width: 8px; height: 8px; background: var(--cf-brand); border-radius: 4px; display: inline-block;"></span>
            </div>
            <h3 style="font-size: 26px; font-weight: 600; letter-spacing: -0.02em; color: var(--cf-ink); margin: 0; line-height: 1.2;">{v.t}</h3>
            <p style="font-size: 15px; line-height: 1.65; color: var(--cf-dim); margin: 0;">{v.d}</p>
          </div>
        ))}
      </div>
  </Section>

  <!-- ═══════════════════════════════════════════════════════════
       TEAM — 6 cards
  ════════════════════════════════════════════════════════════ -->
  <Section surface="paper" rule="both">
      <SectionHeader
        eyebrow="Equipo · 2 personas"
        title="Los que firman cada decisión."
        lede="No vas a hablar con un gerente comercial. Hablas, desde el primer correo, con quien va a arquitectar y construir tu sistema."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5" style="max-width: 800px;">
        {team.map((m) => (
          <div
            class="cf-reveal"
            data-cf-reveal
            style="background: var(--cf-paper); border: 1px solid var(--cf-rule); border-radius: 14px; overflow: hidden;"
          >
            <!-- Color header with initials -->
            <div style={`background: ${m.color}; aspect-ratio: 4/3; display: flex; align-items: flex-end; padding: 24px; position: relative;`}>
              <span style="font-size: 96px; font-weight: 700; color: rgba(255,255,255,0.92); letter-spacing: -0.04em; line-height: 0.9;">{m.initials}</span>
              <span style="position: absolute; top: 16px; right: 16px; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: rgba(255,255,255,0.85); letter-spacing: 0.12em; padding: 4px 10px; border: 1px solid rgba(255,255,255,0.4); border-radius: 999px;">
                {m.city.toUpperCase()}
              </span>
            </div>
            <!-- Card body -->
            <div style="padding: 24px 24px 26px;">
              <h3 style="font-size: 20px; font-weight: 600; letter-spacing: -0.018em; color: var(--cf-ink); margin: 0;">{m.name}</h3>
              <div style="font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: var(--cf-brand); margin-top: 4px; letter-spacing: 0.08em;">{m.role.toUpperCase()}</div>
              <p style="font-size: 13.5px; line-height: 1.6; color: var(--cf-dim); margin-top: 16px;">{m.bio}</p>
            </div>
          </div>
        ))}
      </div>

  </Section>

  <!-- ═══════════════════════════════════════════════════════════
       LOCATIONS — Tres oficinas
  ════════════════════════════════════════════════════════════ -->
  <Section>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.6fr] gap-10 lg:gap-20 items-start">

        <!-- Left: heading -->
        <div class="cf-reveal" data-cf-reveal>
          <Eyebrow>Ubicaciones</Eyebrow>
          <h2 style="font-size: clamp(28px, 4.5vw, 56px); font-weight: 600; letter-spacing: -0.035em; color: var(--cf-ink); margin: 22px 0 0; line-height: 1;">
            Chía,<br />
            <span style="color: var(--cf-dim);">Cundinamarca.</span>
          </h2>
          <p style="font-size: 15.5px; line-height: 1.65; color: var(--cf-dim); margin-top: 20px; max-width: 360px;">
            Trabajamos desde Chía, Colombia. Atendemos clientes de forma remota sin problema.
          </p>
        </div>

        <!-- Right: location card -->
        <div style="display: grid; grid-template-columns: 1fr; gap: 20px; max-width: 320px;">
          {locations.map((c) => (
            <div
              class="cf-reveal"
              data-cf-reveal
              style={`
                background: ${c.primary ? 'var(--cf-navy)' : 'var(--cf-paper)'};
                color: ${c.primary ? 'var(--cf-paper)' : 'var(--cf-ink)'};
                border-radius: 14px;
                padding: 32px 28px;
                border: 1px solid ${c.primary ? 'var(--cf-navy)' : 'var(--cf-rule)'};
                position: relative;
              `}
            >
              {c.primary && (
                <span style="position: absolute; top: 16px; right: 16px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.14em; color: var(--cf-brand); padding: 3px 8px; border: 1px solid var(--cf-brand); border-radius: 999px;">HQ</span>
              )}
              <div style={`font-family: 'JetBrains Mono', monospace; font-size: 11px; color: ${c.primary ? 'var(--cf-brand)' : 'var(--cf-dim)'}; letter-spacing: 0.14em;`}>{c.country.toUpperCase()}</div>
              <h3 style="font-size: 32px; font-weight: 600; margin: 8px 0 16px; letter-spacing: -0.025em; line-height: 1;">{c.city}</h3>
              <div style={`font-size: 13.5px; color: ${c.primary ? 'var(--cf-dark-text-2)' : 'var(--cf-dim)'}; white-space: pre-line; line-height: 1.55; padding-bottom: 18px; border-bottom: 1px solid ${c.primary ? 'var(--cf-dark-border)' : 'var(--cf-rule)'};`}>{c.addr}</div>
              <div style={`margin-top: 16px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: ${c.primary ? 'var(--cf-dark-text-2)' : 'var(--cf-text)'};`}>{c.count}</div>
            </div>
          ))}
        </div>

      </div>
  </Section>


  <!-- ═══════════════════════════════════════════════════════════
       CLOSING CTA
  ════════════════════════════════════════════════════════════ -->
  <ClosingCTA />

</Layout>
