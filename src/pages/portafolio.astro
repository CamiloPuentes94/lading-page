---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/shared/Eyebrow.astro';
import PageHero from '../components/shared/PageHero.astro';
import { YEARS_ACTIVE_LABEL } from '../data/company';
import ClosingCTA from '../components/shared/ClosingCTA.astro';

const CASES = [
  {
    id: 'sinerlly',
    client: 'Camandre Factory',
    cat: 'Producto',
    year: '2025',
    title: 'Sistema POS',
    desc: 'Producto propio de Camandre Factory. Punto de venta para distribuidoras y negocios de alimentos. Primer cliente en producción: Sinerlly.',
    metrics: [{ k: '2025', v: 'En producción' }, { k: 'Producto propio', v: 'Disponible' }],
    stack: ['React', 'Node.js', 'PostgreSQL'],
    mock: 'sinerlly',
    url: 'https://pos.camandrefactory.com',
    story: {
      problem:
        'El sistema con el que vendía era lento, y en un negocio que factura al ' +
        'peso eso no molesta una vez: molesta en cada artículo de cada venta. ' +
        'Debajo de eso había algo que no se ve desde el mostrador — Sinerlly ' +
        'compra a crédito a sus proveedores y no tenía cómo saber cuánto debía ' +
        'en total ni cuánto llevaba pagado.',
      decision:
        'Equipo nuevo y un punto de venta que no se frenara en la venta, con el ' +
        'crédito de proveedores adentro del mismo sistema en vez de a un ' +
        'costado. Registrar una venta y saber cómo va la cuenta con cada ' +
        'proveedor dejaron de ser dos tareas distintas.',
      result:
        'Sinerlly cierra el día con las cuentas claras: ventas, cuentas de cobro ' +
        'y el estado de lo que debe y lo que pagó a cada proveedor, en un solo ' +
        'lugar. Y el mostrador dejó de esperar al sistema.',
    },
  },
  {
    id: 'falcon-1',
    client: 'Falcon Precision',
    cat: 'Sistemas',
    year: '2025',
    title: 'App de gestión interna',
    desc: 'Aplicación interna para optimizar procesos administrativos en entidad del estado.',
    metrics: [{ k: '2025', v: 'En producción' }, { k: 'Estado', v: 'Sector público' }],
    stack: ['React', 'API REST', 'PostgreSQL'],
    mock: 'falcon1',
  },
  {
    id: 'falcon-2',
    client: 'Falcon Precision',
    cat: 'Sistemas',
    year: '2025',
    title: 'App operativa interna',
    desc: 'Segunda aplicación interna para automatización de procesos operativos en entidad del estado.',
    metrics: [{ k: '2025', v: 'En producción' }, { k: 'Estado', v: 'Sector público' }],
    stack: ['React', 'Node.js', 'PostgreSQL'],
    mock: 'falcon2',
  },
];

/**
 * The case list as structured data, built from the same array the page
 * renders so the two can never drift apart.
 */
const caseList = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Proyectos en producción de Camandre Factory',
    numberOfItems: CASES.length,
    itemListElement: CASES.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'CreativeWork',
        name: c.title,
        description: c.desc,
        dateCreated: c.year,
        about: c.cat,
        keywords: c.stack.join(', '),
        creator: {
          '@type': 'ProfessionalService',
          name: 'Camandre Factory',
          url: 'https://camandrefactory.com/',
        },
      },
    })),
  },
];
---

<Layout
  title="Portafolio — Casos de software a medida | Camandre Factory"
  description="Tres proyectos en producción: el Sistema POS de Sinerlly y dos aplicaciones para Falcon Precision. El problema, la decisión técnica y el resultado."
  activePage="portafolio"
  ogImage="/og-portafolio.png"
  schema={caseList}
>

  <!-- ═══════════════════════════════════════════════════════════
       PORTFOLIO HERO
  ════════════════════════════════════════════════════════════ -->
  <PageHero
    eyebrow="Portafolio · 3 proyectos en producción"
    maxWidth="1280px"
    contentWidth="900px"
  >
    <h1
      data-cf-reveal
      style="
        font-size: clamp(56px, 6.5vw, 96px);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 0.98;
        color: var(--cf-ink);
        margin: 24px 0 0;
        text-wrap: balance;
      "
    >
      Sistemas en producción.<br />
      <span style="color: var(--cf-dim);">Métricas reales.</span>
    </h1>
    <p
      data-cf-reveal
      style="
        font-size: 19px;
        line-height: 1.6;
        color: var(--cf-dim);
        margin-top: 32px;
        max-width: 640px;
      "
    >
      Tres proyectos. Todos están en producción hoy. Construidos desde cero con equipos
      pequeños, sin atajos y sin dejarles un sistema que después no puedan mantener.
    </p>

      <!-- Stats bar -->
      <div
        slot="below"
        class="grid grid-cols-2 sm:grid-cols-4"
        data-cf-reveal
        style="
          margin-top: 64px;
          gap: 0;
          padding-top: 32px;
          border-top: 1px solid var(--cf-rule);
        "
      >
        {[
          { k: '3',    v: 'Proyectos en producción' },
          { k: '1',    v: 'País en operación' },
          { k: YEARS_ACTIVE_LABEL, v: 'En el oficio' },
          { k: '100%', v: 'Uptime promedio' },
        ].map((s, i) => (
          <div
            style={`
              border-right: ${i < 3 ? '1px solid var(--cf-rule)' : 'none'};
              padding-left: ${i === 0 ? '0' : '32px'};
            `}
          >
            <div style="font-size: clamp(32px, 4vw, 48px); font-weight: 600; color: var(--cf-ink); letter-spacing: -0.025em; line-height: 1;">
              {s.k}
            </div>
            <div class="font-mono uppercase text-[11px] tracking-[0.08em] text-cf-dim mt-2.5">
              {s.v}
            </div>
          </div>
        ))}
      </div>
  </PageHero>

  <!-- ═══════════════════════════════════════════════════════════
       PORTFOLIO GRID
  ════════════════════════════════════════════════════════════ -->
  <section class="py-16 md:py-20 lg:py-[100px]" style="background: var(--cf-bg);">
    <div class="px-5 md:px-10" style="max-width: 1280px; margin: 0 auto;">

      <!-- Header row + filters -->
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; flex-wrap: wrap; gap: 20px;">
        <div>
          <Eyebrow>Trabajo</Eyebrow>
          <h2 style="font-size: 44px; font-weight: 600; letter-spacing: -0.03em; color: var(--cf-ink); margin: 14px 0 0; line-height: 1.05;">
            Filtrar por disciplina
          </h2>
        </div>

        <!-- Filter pills -->
        <div
          id="filter-bar"
          style="
            display: inline-flex;
            padding: 5px;
            background: var(--cf-paper);
            border: 1px solid var(--cf-rule);
            border-radius: 999px;
          "
        >
          {['Todos', 'Producto', 'Sistemas'].map((cat) => (
            <button
              data-filter={cat}
              class={cat === 'Todos' ? 'active' : ''}
              style="
                padding: 8px 16px;
                border: none;
                cursor: pointer;
                
                font-size: 13px;
                font-weight: 500;
                border-radius: 999px;
                transition: all 0.2s;
                background: transparent;
                color: var(--cf-ink);
              "
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!--
        Cards grid.

        items-start matters: a grid row stretches its items to the tallest one,
        and the cases no longer hold the same amount of text. Sinerlly carries a
        problem/decision/result, the two Falcon systems are internal work for a
        public body and carry a summary, so stretching left ~500px of blank card
        under each of them — which reads as content that failed to load rather
        than as a shorter case. Let each card be its own height.
      -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 items-start">
        {CASES.map((c) => (
          <article
            class="cf-card cf-reveal"
            data-cf-reveal
            data-cat={c.cat}
            style="
              background: var(--cf-paper);
              border: 1px solid var(--cf-rule);
              border-radius: 14px;
              overflow: hidden;
              display: flex;
              flex-direction: column;
            "
          >
            <!-- Visual mock -->
            <div style="aspect-ratio: 4/3; border-bottom: 1px solid var(--cf-rule); position: relative; overflow: hidden;">

              {c.mock === 'sinerlly' && (
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; background: var(--cf-dark-surface); padding: 20px; box-sizing: border-box; gap: 0;">
                  <div style="width: 100%; background: rgba(255,255,255,0.04); border-radius: 8px; border: 1px solid var(--cf-dark-border); overflow: hidden;">
                    <div style="padding: 10px 12px; border-bottom: 1px solid var(--cf-dark-border); display: flex; justify-content: space-between; align-items: center;">
                      <span style="font-family: 'JetBrains Mono', monospace; font-size: 9px; color: var(--cf-dark-faint); letter-spacing: 0.1em;">PUNTO DE VENTA</span>
                      <span style="font-family: 'JetBrains Mono', monospace; font-size: 9px; color: var(--cf-brand);">● activo</span>
                    </div>
                    {[
                      { p: 'Chorizo x500g', q: '12', price: '$8.500' },
                      { p: 'Butifarra', q: '6', price: '$12.000' },
                      { p: 'Longaniza', q: '8', price: '$9.500' },
                    ].map((r, i) => (
                      <div style={`display: grid; grid-template-columns: 1fr 30px 70px; gap: 8px; padding: 8px 12px; border-top: ${i === 0 ? 'none' : '1px solid var(--cf-dark-border)'};`}>
                        <span style="font-size: 11px; color: #FFFFFF;">{r.p}</span>
                        <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--cf-dark-faint); text-align: center;">{r.q}</span>
                        <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--cf-brand); text-align: right;">{r.price}</span>
                      </div>
                    ))}
                    <div style="padding: 10px 12px; border-top: 1px solid var(--cf-dark-border); display: flex; justify-content: space-between;">
                      <span style="font-size: 12px; font-weight: 600; color: #FFFFFF;">Total</span>
                      <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 600; color: var(--cf-brand);">$136.000</span>
                    </div>
                  </div>
                </div>
              )}

              {c.mock === 'falcon1' && (
                <div style="display: flex; flex-direction: column; align-items: flex-start; justify-content: center; width: 100%; height: 100%; background: var(--cf-dark-surface); padding: 24px; box-sizing: border-box; gap: 10px;">
                  <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--cf-brand); letter-spacing: 0.1em;">GESTIÓN INTERNA</div>
                  <div style="width: 100%; display: flex; flex-direction: column; gap: 6px; margin-top: 4px;">
                    {[
                      { label: 'Solicitudes', val: '87%' },
                      { label: 'Procesadas', val: '92%' },
                      { label: 'Pendientes', val: '38%' },
                    ].map((r) => (
                      <div style="display: flex; align-items: center; gap: 8px; width: 100%;">
                        <span style="font-family: 'JetBrains Mono', monospace; font-size: 9px; color: var(--cf-dark-faint); width: 70px; flex-shrink: 0;">{r.label}</span>
                        <div style="flex: 1; height: 8px; background: var(--cf-dark-border); border-radius: 2px; overflow: hidden;">
                          <div style={`width: ${r.val}; height: 100%; background: var(--cf-brand);`}></div>
                        </div>
                        <span style="font-family: 'JetBrains Mono', monospace; font-size: 9px; color: #FFFFFF; width: 32px; text-align: right;">{r.val}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {c.mock === 'falcon2' && (
                <div style="display: flex; flex-direction: column; align-items: flex-start; justify-content: center; width: 100%; height: 100%; background: var(--cf-dark-surface); padding: 24px; box-sizing: border-box; gap: 10px;">
                  <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--cf-brand); letter-spacing: 0.1em;">APP OPERATIVA</div>
                  <div style="width: 100%; display: flex; flex-direction: column; gap: 8px; margin-top: 4px;">
                    {['Registro', 'Validación', 'Aprobación', 'Cierre'].map((step, i) => (
                      <div style="display: flex; align-items: center; gap: 10px;">
                        <div style={`width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 9px; font-weight: 600; background: ${i < 3 ? 'var(--cf-brand)' : 'var(--cf-dark-border)'}; color: ${i < 3 ? '#FFFFFF' : 'var(--cf-dark-faint)'};`}>{i + 1}</div>
                        <span style={`font-size: 12px; color: ${i < 3 ? '#FFFFFF' : 'var(--cf-dark-faint)'};`}>{step}</span>
                        {i < 2 && <span style="font-family: 'JetBrains Mono', monospace; font-size: 9px; color: var(--cf-brand); margin-left: auto;">✓</span>}
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <!-- Category + year badge -->
              <span style="
                position: absolute; top: 16px; left: 16px;
                padding: 4px 12px;
                background: var(--cf-paper);
                color: var(--cf-ink);
                border-radius: 4px;
                font-family: 'JetBrains Mono', monospace;
                font-size: 10.5px;
                letter-spacing: 0.1em;
                border: 1px solid var(--cf-rule);
                white-space: nowrap;
              ">
                {c.cat.toUpperCase()} · {c.year}
              </span>
            </div>

            <!-- Card body -->
            <div style="padding: 24px 24px 22px;">
              <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--cf-brand); letter-spacing: 0.14em; margin-bottom: 12px;">
                {c.client.toUpperCase()}
              </div>
              <h3 style="font-size: 21px; font-weight: 600; letter-spacing: -0.02em; color: var(--cf-ink); margin: 0 0 12px; line-height: 1.2;">
                {c.title}
              </h3>
              <p style="font-size: 14.5px; line-height: 1.6; color: var(--cf-dim); margin: 0;">
                {c.desc}
              </p>

              {c.story && (
                <div style="margin-top: 18px; display: grid; gap: 14px;">
                  {[
                    ['El problema', c.story.problem],
                    ['La decisión', c.story.decision],
                    ['El resultado', c.story.result],
                  ].map(([label, body]) => (
                    <div>
                      <div class="font-mono uppercase text-[9.5px] tracking-[0.14em] text-cf-brand mb-1.5 leading-[1.3]">
                        {label}
                      </div>
                      <p style="font-size: 14.5px; line-height: 1.6; color: var(--cf-dim); margin: 0;">
                        {body}
                      </p>
                    </div>
                  ))}
                </div>
              )}

              <!-- Stats row -->
              <div style="margin-top: 20px; padding-top: 18px; border-top: 1px dashed var(--cf-rule); display: grid; grid-template-columns: 1fr 1fr auto; gap: 20px; align-items: end;">
                {c.metrics.map((m) => (
                  <div>
                    <div style="font-size: 20px; font-weight: 600; color: var(--cf-ink); letter-spacing: -0.02em; line-height: 1;">
                      {m.k}
                    </div>
                    <div class="font-mono uppercase text-[9.5px] tracking-[0.08em] text-cf-dim mt-1.5 leading-[1.3]">
                      {m.v}
                    </div>
                  </div>
                ))}
                {/*
                  Only rendered when the case actually leads somewhere. The two
                  Falcon Precision cards used to show a "Caso →" affordance
                  wired to href="#": it looked clickable, it read as clickable
                  to a screen reader, and it went nowhere. Internal systems for
                  a public body have no public URL to point at.
                */}
                {c.url && (
                  <a
                    class="cf-tap"
                    href={c.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--cf-ink); white-space: nowrap; text-decoration: none;"
                  >
                    Ver sistema →
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Grid footer -->
      <div style="margin-top: 64px; padding: 40px 0; border-top: 1px solid var(--cf-rule); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--cf-dim);">
          Mostrando <span id="portfolio-count">3</span> de 3 casos
        </div>
        <a
          href="mailto:camandrefactory@gmail.com"
          class="cf-navlink cf-tap"
          style="font-size: 14px; font-weight: 600; color: var(--cf-ink);"
        >
          Solicitar acceso al archivo completo →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CLOSING CTA
  ════════════════════════════════════════════════════════════ -->
  <ClosingCTA />

</Layout>

<style>
  #filter-bar button.active {
    background: var(--cf-navy);
    color: #ffffff;
  }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-cat]');
  const countEl = document.getElementById('portfolio-count');

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter as string;
      btns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      let count = 0;
      cards.forEach((card) => {
        const show = filter === 'Todos' || card.dataset.cat === filter;
        card.style.display = show ? '' : 'none';
        if (show) count++;
      });
      if (countEl) countEl.textContent = String(count);
    });
  });
</script>
