---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/shared/Eyebrow.astro';
import ClosingCTA from '../components/shared/ClosingCTA.astro';

const CASES = [
  {
    id: 'helio',
    client: 'Helio Health',
    cat: 'Producto',
    year: '2025',
    title: 'Plataforma clínica para 200+ médicos',
    desc: 'Reescritura completa de un EMR de 14 años. Migración sin downtime, adopción interna del 96%.',
    metrics: [{ k: '96%', v: 'Adopción' }, { k: '1.2M', v: 'Historias migradas' }],
    stack: ['Astro', 'Go', 'PostgreSQL'],
    mock: 'helio',
  },
  {
    id: 'northwind',
    client: 'Northwind Co.',
    cat: 'Sistemas',
    year: '2025',
    title: 'ERP modular para 9 sucursales',
    desc: 'Migración de 14 hojas de cálculo a un ERP con cierre contable automatizado.',
    metrics: [{ k: '−71%', v: 'Tiempo de cierre' }, { k: '11 sem', v: 'Duración' }],
    stack: ['Django', 'PostgreSQL', 'Redis'],
    mock: 'northwind',
  },
  {
    id: 'trevia',
    client: 'Trevia Logistics',
    cat: 'Producto',
    year: '2024',
    title: 'TMS con visibilidad en tiempo real',
    desc: 'Plataforma de gestión de transporte multimodal para 1,400+ rutas diarias.',
    metrics: [{ k: '99.98%', v: 'Uptime' }, { k: '+38%', v: 'Eficiencia ruta' }],
    stack: ['React', 'Go', 'Kafka'],
    mock: 'trevia',
  },
  {
    id: 'banconorte',
    client: 'Banco Norte',
    cat: 'Consultoría',
    year: '2024',
    title: 'Due diligence técnico (M&A · USD 80M)',
    desc: 'Auditoría de plataforma post-adquisición de fintech regional. Plan de integración a 9 meses.',
    metrics: [{ k: '9 mes', v: 'Plan' }, { k: '7', v: 'Sistemas auditados' }],
    stack: ['Audit', 'Strategy'],
    mock: 'banco',
  },
  {
    id: 'lumen',
    client: 'Lumen Foods',
    cat: 'Sistemas',
    year: '2024',
    title: 'CRM + e-commerce headless',
    desc: 'Reemplazo de Magento por Astro + Shopify Hydrogen. Backoffice unificado para 12 marcas.',
    metrics: [{ k: '−2.4s', v: 'TTI promedio' }, { k: '+22%', v: 'Conversión' }],
    stack: ['Astro', 'Shopify', 'Postgres'],
    mock: 'lumen',
  },
  {
    id: 'quanta',
    client: 'Quanta Energy',
    cat: 'Infraestructura',
    year: '2025',
    title: 'Migración multi-region a GCP',
    desc: 'Reescritura de plataforma de monitoreo de plantas solares. SRE end-to-end.',
    metrics: [{ k: '−54%', v: 'Costo cloud' }, { k: '12', v: 'Regiones' }],
    stack: ['GCP', 'Terraform', 'Go'],
    mock: 'quanta',
  },
  {
    id: 'estudio',
    client: 'Estudio Plomo',
    cat: 'Producto',
    year: '2024',
    title: 'Portal de gestión de proyectos',
    desc: 'Herramienta interna para 80+ proyectos simultáneos en estudio creativo.',
    metrics: [{ k: '80+', v: 'Proyectos' }, { k: '−63%', v: 'Tiempo admin' }],
    stack: ['Astro', 'React', 'Postgres'],
    mock: 'estudio',
  },
  {
    id: 'acme',
    client: 'ACME Industries',
    cat: 'Infraestructura',
    year: '2023',
    title: 'IoT + dashboard de planta',
    desc: 'Ingesta de 2.4M eventos/día desde sensores industriales. Alertas en tiempo real.',
    metrics: [{ k: '2.4M', v: 'Eventos/día' }, { k: '99.99%', v: 'Disponibilidad' }],
    stack: ['Kafka', 'TimescaleDB', 'Go'],
    mock: 'acme',
  },
];
---

<Layout title="Portafolio — Camandre Factory" activePage="portafolio">

  <!-- ═══════════════════════════════════════════════════════════
       PORTFOLIO HERO
  ════════════════════════════════════════════════════════════ -->
  <section style="padding: 110px 0 80px; border-bottom: 1px solid var(--cf-rule); position: relative; overflow: hidden;">

    <!-- Grid backdrop -->
    <div
      aria-hidden="true"
      style="
        position: absolute; inset: 0;
        background-image:
          linear-gradient(rgba(11,19,43,0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(11,19,43,0.05) 1px, transparent 1px);
        background-size: 56px 56px;
        -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black, transparent 90%);
        mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black, transparent 90%);
      "
    ></div>

    <div style="max-width: 1280px; margin: 0 auto; padding: 0 40px; position: relative;">
      <div class="cf-stagger" style="max-width: 900px;">
        <Eyebrow>Portafolio · 8 piezas seleccionadas</Eyebrow>
        <h1
          data-cf-reveal
          style="
            font-family: 'Geist', sans-serif;
            font-size: clamp(56px, 6.5vw, 96px);
            font-weight: 600;
            letter-spacing: -0.04em;
            line-height: 0.98;
            color: var(--cf-ink);
            margin: 24px 0 0;
            text-wrap: balance;
          "
        >
          Sistemas en producción.<br />
          <span style="color: var(--cf-dim);">Métricas reales.</span>
        </h1>
        <p
          data-cf-reveal
          style="
            font-size: 19px;
            line-height: 1.6;
            color: var(--cf-dim);
            margin-top: 32px;
            max-width: 640px;
          "
        >
          Una selección de 40+ proyectos. Todos están en producción hoy.
          Las métricas no son proyecciones, son lo que pasó después del lanzamiento.
        </p>
      </div>

      <!-- Stats bar -->
      <div
        data-cf-reveal
        style="
          margin-top: 64px;
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 0;
          padding-top: 32px;
          border-top: 1px solid var(--cf-rule);
        "
      >
        {[
          { k: '40+',    v: 'Proyectos entregados' },
          { k: '12',     v: 'Países en operación' },
          { k: '8 años', v: 'En el oficio' },
          { k: '99.98%', v: 'Uptime promedio' },
        ].map((s, i) => (
          <div
            style={`
              border-right: ${i < 3 ? '1px solid var(--cf-rule)' : 'none'};
              padding-left: ${i === 0 ? '0' : '32px'};
            `}
          >
            <div style="font-family: 'Geist', sans-serif; font-size: clamp(32px, 4vw, 48px); font-weight: 600; color: var(--cf-ink); letter-spacing: -0.025em; line-height: 1;">
              {s.k}
            </div>
            <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--cf-dim); margin-top: 10px; letter-spacing: 0.08em; text-transform: uppercase;">
              {s.v}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       PORTFOLIO GRID
  ════════════════════════════════════════════════════════════ -->
  <section style="padding: 100px 0 120px; background: var(--cf-bg);">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0 40px;">

      <!-- Header row + filters -->
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; flex-wrap: wrap; gap: 20px;">
        <div>
          <Eyebrow>Trabajo</Eyebrow>
          <h2 style="font-family: 'Geist', sans-serif; font-size: 44px; font-weight: 600; letter-spacing: -0.03em; color: var(--cf-ink); margin: 14px 0 0; line-height: 1.05;">
            Filtrar por disciplina
          </h2>
        </div>

        <!-- Filter pills -->
        <div
          id="filter-bar"
          style="
            display: inline-flex;
            padding: 5px;
            background: var(--cf-paper);
            border: 1px solid var(--cf-rule);
            border-radius: 999px;
          "
        >
          {['Todos', 'Producto', 'Sistemas', 'Infraestructura', 'Consultoría'].map((cat) => (
            <button
              data-filter={cat}
              class={cat === 'Todos' ? 'active' : ''}
              style="
                padding: 8px 16px;
                border: none;
                cursor: pointer;
                font-family: 'Geist', sans-serif;
                font-size: 13px;
                font-weight: 500;
                border-radius: 999px;
                transition: all 0.2s;
                background: transparent;
                color: var(--cf-ink);
              "
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Cards grid -->
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
        {CASES.map((c) => (
          <article
            class="cf-card cf-reveal"
            data-cf-reveal
            data-cat={c.cat}
            style="
              background: var(--cf-paper);
              border: 1px solid var(--cf-rule);
              border-radius: 14px;
              overflow: hidden;
              display: flex;
              flex-direction: column;
            "
          >
            <!-- Visual mock -->
            <div style="aspect-ratio: 4/3; border-bottom: 1px solid var(--cf-rule); position: relative; overflow: hidden;">

              {c.mock === 'helio' && (
                <div style="display: flex; align-items: flex-end; justify-content: center; width: 100%; height: 100%; background: linear-gradient(135deg, #0F2557, #0EA472); padding: 28px; box-sizing: border-box;">
                  <div style="width: 100%; background: rgba(7,12,32,0.7); backdrop-filter: blur(8px); border-radius: 8px; padding: 12px 14px; border: 1px solid rgba(255,255,255,0.15);">
                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #9BD6BC; letter-spacing: 0.1em;">● ATENCIONES · 14</div>
                    <div style="font-family: 'Geist', sans-serif; font-size: 22px; color: #FFFFFF; font-weight: 600; margin-top: 4px;">Sala 02 · M. Quispe</div>
                  </div>
                </div>
              )}

              {c.mock === 'northwind' && (
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; background: #0B132B; padding: 24px; box-sizing: border-box; gap: 6px;">
                  {[80, 64, 92, 48, 70].map((w, i) => (
                    <div style="width: 100%; display: flex; gap: 6px; align-items: center;">
                      <span style="font-family: 'JetBrains Mono', monospace; font-size: 9px; color: #7E869A; width: 38px; flex-shrink: 0;">{`SUC-0${i + 1}`}</span>
                      <div style="flex: 1; height: 10px; background: #1B2548; border-radius: 2px; overflow: hidden;">
                        <div style={`width: ${w}%; height: 100%; background: var(--cf-brand);`}></div>
                      </div>
                      <span style="font-family: 'JetBrains Mono', monospace; font-size: 9px; color: #FFFFFF; width: 28px; text-align: right;">{w}%</span>
                    </div>
                  ))}
                </div>
              )}

              {c.mock === 'trevia' && (
                <div style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: #FAF8F3;">
                  <svg viewBox="0 0 200 140" width="80%" height="80%">
                    <defs>
                      <pattern id="trevia-dots" width="10" height="10" patternUnits="userSpaceOnUse">
                        <circle cx="1" cy="1" r="0.8" fill="#E5E2D7" />
                      </pattern>
                    </defs>
                    <rect width="200" height="140" fill="url(#trevia-dots)" />
                    <path d="M 20 110 Q 60 90 90 80 T 140 50 T 180 30" stroke="#0F2557" stroke-width="2" fill="none" stroke-dasharray="4 3" />
                    <circle cx="20" cy="110" r="6" fill="#0EA472" />
                    <circle cx="90" cy="80" r="5" fill="#0F2557" />
                    <circle cx="140" cy="50" r="5" fill="#0F2557" />
                    <circle cx="180" cy="30" r="6" fill="#0EA472" />
                    <text x="20" y="128" font-family="JetBrains Mono" font-size="7" fill="#5C657A">BOG</text>
                    <text x="172" y="22" font-family="JetBrains Mono" font-size="7" fill="#5C657A">MAD</text>
                  </svg>
                </div>
              )}

              {c.mock === 'banco' && (
                <div style="display: flex; flex-direction: column; align-items: flex-start; justify-content: center; width: 100%; height: 100%; background: #F2EFE7; padding: 24px; box-sizing: border-box; gap: 10px;">
                  <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #5C657A; letter-spacing: 0.14em;">DUE DILIGENCE</div>
                  <div style="font-family: 'Geist', sans-serif; font-size: 32px; font-weight: 600; color: #0B132B; letter-spacing: -0.025em;">USD 80M</div>
                  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; width: 100%; margin-top: auto;">
                    {['CORE', 'API', 'DATA', 'INFRA', 'SEC', 'PEOPLE'].map((label, i) => (
                      <div style={`
                        background: ${i < 3 ? 'var(--cf-brand)' : '#FFFFFF'};
                        color: ${i < 3 ? '#FFFFFF' : '#5C657A'};
                        font-family: 'JetBrains Mono', monospace;
                        font-size: 9px;
                        padding: 4px 8px;
                        border-radius: 3px;
                        text-align: center;
                        border: 1px solid ${i < 3 ? 'var(--cf-brand)' : '#E5E2D7'};
                      `}>{label}</div>
                    ))}
                  </div>
                </div>
              )}

              {c.mock === 'lumen' && (
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; background: linear-gradient(180deg, #F7F0E4, #E8DDC4); padding: 24px; box-sizing: border-box; gap: 8px;">
                  <div style="width: 100%; display: flex; justify-content: space-between;">
                    <div style="font-family: 'Geist', sans-serif; font-size: 11px; color: #0B132B; font-weight: 600;">Lumen / Pantry</div>
                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #5C657A;">+22% conv.</div>
                  </div>
                  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; flex: 1; width: 100%;">
                    {['#D9C49B', '#6B7857', '#B27554', '#3F4A3E', '#C99B6F', '#8A6F4D'].map((color) => (
                      <div style={`background: ${color}; border-radius: 4px; aspect-ratio: 1/1;`}></div>
                    ))}
                  </div>
                </div>
              )}

              {c.mock === 'quanta' && (
                <div style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: #091A3D; padding: 20px; box-sizing: border-box;">
                  <svg viewBox="0 0 200 140" width="100%" height="100%">
                    <g opacity="0.4">
                      {[40, 70, 100, 130, 160].map((x) => (
                        <line x1={x} y1="20" x2={x} y2="120" stroke="#1B2548" />
                      ))}
                      {[40, 70, 100].map((y) => (
                        <line x1="20" y1={y} x2="180" y2={y} stroke="#1B2548" />
                      ))}
                    </g>
                    <polyline points="20,100 50,80 80,60 110,68 140,40 170,30 200,28" stroke="#0EA472" stroke-width="2" fill="none" />
                    <polyline points="20,110 50,100 80,90 110,82 140,70 170,68 200,60" stroke="#FFBD2E" stroke-width="1.5" fill="none" stroke-dasharray="3 3" />
                    {([
                      [50, 80], [80, 60], [110, 68], [140, 40], [170, 30]
                    ] as [number, number][]).map(([x, y]) => (
                      <circle cx={x} cy={y} r="3" fill="#0EA472" />
                    ))}
                  </svg>
                </div>
              )}

              {c.mock === 'estudio' && (
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; background: #FAF8F3; padding: 22px; box-sizing: border-box; gap: 8px;">
                  {[
                    { color: '#0F2557', p: 80,  label: 'Aequus · campaña 2025' },
                    { color: '#0EA472', p: 100, label: 'Borgia · identidad' },
                    { color: '#C28419', p: 60,  label: 'Mantra · web v2' },
                    { color: '#0F2557', p: 40,  label: 'Halo · empaques' },
                  ].map((r) => (
                    <div style="display: flex; align-items: center; gap: 10px; width: 100%;">
                      <span style={`width: 14px; height: 14px; background: ${r.color}; border-radius: 3px; flex-shrink: 0;`}></span>
                      <span style="font-family: 'Geist', sans-serif; font-size: 11px; color: #0B132B; font-weight: 500; flex: 1;">{r.label}</span>
                      <div style="width: 40px; height: 5px; background: #E5E2D7; border-radius: 2px; overflow: hidden;">
                        <div style={`width: ${r.p}%; height: 100%; background: ${r.color};`}></div>
                      </div>
                    </div>
                  ))}
                </div>
              )}

              {c.mock === 'acme' && (
                <div style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: #0B132B; padding: 20px; box-sizing: border-box;">
                  <svg viewBox="0 0 200 140" width="100%" height="100%">
                    {Array.from({ length: 30 }, (_, i) => {
                      const x = 10 + (i % 10) * 18;
                      const y = 20 + Math.floor(i / 10) * 36;
                      const lit = (i * 7) % 5 < 2;
                      return (
                        <g>
                          <rect x={x} y={y} width="12" height="24" rx="2" fill={lit ? '#0EA472' : '#1B2548'} opacity={lit ? 1 : 0.6} />
                          {lit && <rect x={x} y={y} width="12" height="24" rx="2" fill="#0EA472" opacity="0.2" />}
                        </g>
                      );
                    })}
                    <text x="10" y="135" font-family="JetBrains Mono" font-size="8" fill="#7E869A">SENSORES · 30 · 2.4M EVTS/DÍA</text>
                  </svg>
                </div>
              )}

              <!-- Category + year badge -->
              <span style="
                position: absolute; top: 16px; left: 16px;
                padding: 4px 12px;
                background: var(--cf-paper);
                color: var(--cf-ink);
                border-radius: 4px;
                font-family: 'JetBrains Mono', monospace;
                font-size: 10.5px;
                letter-spacing: 0.1em;
                border: 1px solid var(--cf-rule);
                white-space: nowrap;
              ">
                {c.cat.toUpperCase()} · {c.year}
              </span>
            </div>

            <!-- Card body -->
            <div style="padding: 24px 24px 22px;">
              <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--cf-brand); letter-spacing: 0.14em; margin-bottom: 12px;">
                {c.client.toUpperCase()}
              </div>
              <h3 style="font-family: 'Geist', sans-serif; font-size: 21px; font-weight: 600; letter-spacing: -0.02em; color: var(--cf-ink); margin: 0 0 12px; line-height: 1.2;">
                {c.title}
              </h3>
              <p style="font-size: 14.5px; line-height: 1.6; color: var(--cf-dim); margin: 0;">
                {c.desc}
              </p>

              <!-- Stats row -->
              <div style="margin-top: 20px; padding-top: 18px; border-top: 1px dashed var(--cf-rule); display: grid; grid-template-columns: 1fr 1fr auto; gap: 20px; align-items: end;">
                {c.metrics.map((m) => (
                  <div>
                    <div style="font-family: 'Geist', sans-serif; font-size: 20px; font-weight: 600; color: var(--cf-ink); letter-spacing: -0.02em; line-height: 1;">
                      {m.k}
                    </div>
                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 9.5px; color: var(--cf-dim); margin-top: 6px; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.3;">
                      {m.v}
                    </div>
                  </div>
                ))}
                <a href="#" style="display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--cf-ink); white-space: nowrap; text-decoration: none;">
                  Caso →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Grid footer -->
      <div style="margin-top: 64px; padding: 40px 0; border-top: 1px solid var(--cf-rule); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--cf-dim);">
          Mostrando <span id="portfolio-count">8</span> de 8 casos · archivo completo bajo NDA
        </div>
        <a
          href="mailto:hola@camandre.factory"
          class="cf-navlink"
          style="font-size: 14px; font-weight: 600; color: var(--cf-ink);"
        >
          Solicitar acceso al archivo completo →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CLOSING CTA
  ════════════════════════════════════════════════════════════ -->
  <ClosingCTA />

</Layout>

<style>
  #filter-bar button.active {
    background: var(--cf-navy);
    color: #ffffff;
  }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-cat]');
  const countEl = document.getElementById('portfolio-count');

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter as string;
      btns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      let count = 0;
      cards.forEach((card) => {
        const show = filter === 'Todos' || card.dataset.cat === filter;
        card.style.display = show ? '' : 'none';
        if (show) count++;
      });
      if (countEl) countEl.textContent = String(count);
    });
  });
</script>
