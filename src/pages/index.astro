---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/shared/Eyebrow.astro';
import Button from '../components/shared/Button.astro';
import SectionHeader from '../components/shared/SectionHeader.astro';
import ClosingCTA from '../components/shared/ClosingCTA.astro';
---

<Layout title="Camandre Factory — Software a medida para empresas que toman decisiones serias" activePage="home">

  <!-- ═══════════════════════════════════════════════════════════
       HERO
  ════════════════════════════════════════════════════════════ -->
  <section style="position: relative; overflow: hidden; border-bottom: 1px solid var(--cf-rule);">
    <!-- Faint grid backdrop -->
    <div
      aria-hidden="true"
      style="
        position: absolute; inset: 0;
        background-image:
          linear-gradient(var(--cf-ink-08, rgba(11,19,43,0.031)) 1px, transparent 1px),
          linear-gradient(90deg, var(--cf-ink-08, rgba(11,19,43,0.031)) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black, transparent 90%);
        -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black, transparent 90%);
        pointer-events: none;
      "
    ></div>

    <div style="max-width: 1240px; margin: 0 auto; padding: 110px 40px 100px; position: relative;">
      <div style="display: grid; grid-template-columns: 1.25fr 1fr; gap: 72px; align-items: center;">

        <!-- Left column — stagger animated -->
        <div class="cf-stagger">

          <!-- Badge pill -->
          <div style="
            display: inline-flex; align-items: center; gap: 10px;
            padding: 6px 14px; border-radius: 999px;
            background: var(--cf-paper); border: 1px solid var(--cf-rule);
            font-family: 'JetBrains Mono', monospace; font-size: 11.5px;
            color: var(--cf-ink); letter-spacing: 0.04em;
          ">
            <span
              class="cf-pulse"
              style="position: relative; display: inline-block; width: 7px; height: 7px; background: var(--cf-brand); border-radius: 999px;"
            ></span>
            <span>EST. 2019 · BOGOTÁ · MADRID · CDMX</span>
          </div>

          <!-- H1 -->
          <h1 style="
            font-family: 'Geist', system-ui, sans-serif;
            font-size: clamp(56px, 6.5vw, 96px);
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 1.0;
            color: var(--cf-ink);
            margin: 28px 0 0;
            text-wrap: balance;
          ">
            Software a medida{' '}
            <span style="color: var(--cf-brand);">para empresas</span>{' '}
            que toman decisiones serias.
          </h1>

          <!-- Subhead -->
          <p style="
            font-family: 'Geist', system-ui, sans-serif;
            font-size: 18.5px;
            line-height: 1.6;
            color: var(--cf-dim);
            margin: 32px 0 0;
            max-width: 520px;
          ">
            Diseñamos, construimos y mantenemos las plataformas, productos y sistemas internos
            que sostienen a empresas con ambiciones técnicas reales.
          </p>

          <!-- CTAs -->
          <div style="display: flex; gap: 12px; margin-top: 40px; align-items: center;">
            <Button href="#contacto" variant="primary" size="lg">Conversemos</Button>
            <Button href="/portafolio" variant="ghost" size="lg" icon={false}>Ver casos de éxito →</Button>
          </div>

          <!-- Stats bar -->
          <div style="
            margin-top: 64px;
            display: grid;
            grid-template-columns: repeat(3, auto);
            gap: 56px;
            padding-top: 28px;
            border-top: 1px solid var(--cf-rule);
          ">
            {[
              { k: '40+',    v: 'proyectos entregados' },
              { k: '99.98%', v: 'uptime promedio' },
              { k: '12',     v: 'países en operación' },
            ].map(s => (
              <div>
                <div style="
                  font-family: 'Geist', system-ui, sans-serif;
                  font-size: 30px; font-weight: 600;
                  color: var(--cf-ink); letter-spacing: -0.02em;
                ">{s.k}</div>
                <div style="
                  font-family: 'JetBrains Mono', monospace;
                  font-size: 11px; color: var(--cf-dim);
                  margin-top: 4px; letter-spacing: 0.06em;
                  text-transform: uppercase;
                ">{s.v}</div>
              </div>
            ))}
          </div>

        </div>

        <!-- Right — code editor -->
        <div style="position: relative;">
          <!-- Hairline accent backdrop -->
          <div
            aria-hidden="true"
            style="
              position: absolute; inset: -20px -20px -20px -10px;
              background: linear-gradient(135deg, rgba(14,164,114,0.063), transparent 50%);
              border-radius: 24px; filter: blur(40px); pointer-events: none;
            "
          ></div>

          <!-- Editor panel -->
          <div style="
            position: relative;
            background: var(--cf-navy-deep);
            border-radius: 14px;
            border: 1px solid #1B2548;
            overflow: hidden;
            box-shadow: 0 30px 80px -40px rgba(11,19,43,0.45);
          ">
            <!-- Titlebar -->
            <div style="
              display: flex; align-items: center; gap: 8px;
              padding: 14px 18px;
              border-bottom: 1px solid #1B2548;
            ">
              <span style="width: 11px; height: 11px; border-radius: 6px; background: #FF5F56; display: inline-block;"></span>
              <span style="width: 11px; height: 11px; border-radius: 6px; background: #FFBD2E; display: inline-block;"></span>
              <span style="width: 11px; height: 11px; border-radius: 6px; background: #27C93F; display: inline-block;"></span>
              <span style="
                flex: 1; text-align: center;
                font-family: 'JetBrains Mono', monospace;
                font-size: 11.5px; color: #7E869A;
              ">projects/helio-health · main · ↑ 2 ↓ 0</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #7E869A;">project.ts</span>
            </div>

            <!-- Body -->
            <div style="
              padding: 24px 24px 28px;
              font-family: 'JetBrains Mono', monospace;
              font-size: 13.5px; line-height: 1.85;
            ">
              <!-- Line 1: comment -->
              <div class="cf-editor-line" style="color: #5C657A; display: flex; gap: 18px; min-height: 24px; animation-delay: 0.45s;">
                <span style="color: #3F4A6B; user-select: none; width: 18px; text-align: right; flex-shrink: 0;">1</span>
                <span style="font-style: italic;">// camandre.factory · sprint 04</span>
              </div>
              <!-- Line 2: blank -->
              <div class="cf-editor-line" style="display: flex; gap: 18px; min-height: 24px; animation-delay: 0.54s;">
                <span style="color: #3F4A6B; user-select: none; width: 18px; text-align: right; flex-shrink: 0;">2</span>
                <span>&nbsp;</span>
              </div>
              <!-- Line 3 -->
              <div class="cf-editor-line" style="color: #E1E5F0; display: flex; gap: 18px; min-height: 24px; animation-delay: 0.63s;">
                <span style="color: #3F4A6B; user-select: none; width: 18px; text-align: right; flex-shrink: 0;">3</span>
                <span>export const project = &#123;</span>
              </div>
              <!-- Line 4: string accent -->
              <div class="cf-editor-line" style="color: #E1E5F0; display: flex; gap: 18px; min-height: 24px; animation-delay: 0.72s;">
                <span style="color: #3F4A6B; user-select: none; width: 18px; text-align: right; flex-shrink: 0;">4</span>
                <span>&nbsp;&nbsp;client: <span style="color: var(--cf-brand);">"Helio Health"</span>,</span>
              </div>
              <!-- Line 5 -->
              <div class="cf-editor-line" style="color: #E1E5F0; display: flex; gap: 18px; min-height: 24px; animation-delay: 0.81s;">
                <span style="color: #3F4A6B; user-select: none; width: 18px; text-align: right; flex-shrink: 0;">5</span>
                <span>&nbsp;&nbsp;stack: &nbsp;[<span style="color: var(--cf-brand);">"Astro"</span>, <span style="color: var(--cf-brand);">"React"</span>, <span style="color: var(--cf-brand);">"Go"</span>, <span style="color: var(--cf-brand);">"GCP"</span>],</span>
              </div>
              <!-- Line 6 -->
              <div class="cf-editor-line" style="color: #E1E5F0; display: flex; gap: 18px; min-height: 24px; animation-delay: 0.90s;">
                <span style="color: #3F4A6B; user-select: none; width: 18px; text-align: right; flex-shrink: 0;">6</span>
                <span>&nbsp;&nbsp;team: &nbsp;&nbsp;&#123; engineers: 4, designers: 1 &#125;,</span>
              </div>
              <!-- Line 7: string accent -->
              <div class="cf-editor-line" style="color: #E1E5F0; display: flex; gap: 18px; min-height: 24px; animation-delay: 0.99s;">
                <span style="color: #3F4A6B; user-select: none; width: 18px; text-align: right; flex-shrink: 0;">7</span>
                <span>&nbsp;&nbsp;status: <span style="color: var(--cf-brand);">"shipping"</span>,</span>
              </div>
              <!-- Line 8 -->
              <div class="cf-editor-line" style="color: #E1E5F0; display: flex; gap: 18px; min-height: 24px; animation-delay: 1.08s;">
                <span style="color: #3F4A6B; user-select: none; width: 18px; text-align: right; flex-shrink: 0;">8</span>
                <span>&nbsp;&nbsp;uptime: 99.98,</span>
              </div>
              <!-- Line 9 -->
              <div class="cf-editor-line" style="color: #E1E5F0; display: flex; gap: 18px; min-height: 24px; animation-delay: 1.17s;">
                <span style="color: #3F4A6B; user-select: none; width: 18px; text-align: right; flex-shrink: 0;">9</span>
                <span>&#125;;</span>
              </div>
              <!-- Line 10: blank -->
              <div class="cf-editor-line" style="display: flex; gap: 18px; min-height: 24px; animation-delay: 1.26s;">
                <span style="color: #3F4A6B; user-select: none; width: 18px; text-align: right; flex-shrink: 0;">10</span>
                <span>&nbsp;</span>
              </div>
              <!-- Line 11: comment accent -->
              <div class="cf-editor-line" style="color: var(--cf-brand); display: flex; gap: 18px; min-height: 24px; animation-delay: 1.35s;">
                <span style="color: #3F4A6B; user-select: none; width: 18px; text-align: right; flex-shrink: 0;">11</span>
                <span style="font-style: italic;">// build · 2026-q2 · all green</span>
              </div>
            </div>

            <!-- Status strip -->
            <div style="
              display: flex; justify-content: space-between;
              padding: 10px 18px;
              border-top: 1px solid #1B2548;
              font-family: 'JetBrains Mono', monospace;
              font-size: 11px; color: #7E869A;
              background: #070C20;
            ">
              <span>● shipping · sprint 04</span>
              <span>p95 184ms · 0 incidentes</span>
            </div>
          </div>

          <!-- Floating metric chip -->
          <div
            class="cf-reveal"
            data-cf-reveal
            style="
              position: absolute; left: -32px; bottom: -32px;
              background: var(--cf-paper);
              border: 1px solid var(--cf-rule);
              border-radius: 14px;
              padding: 14px 18px;
              box-shadow: 0 12px 32px -16px rgba(11,19,43,0.18);
              display: flex; align-items: center; gap: 14px;
            "
          >
            <div style="
              width: 42px; height: 42px; border-radius: 10px;
              background: rgba(14,164,114,0.094);
              display: flex; align-items: center; justify-content: center;
            ">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                   stroke="var(--cf-brand)" stroke-width="2.4"
                   stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 17l6-6 4 4 8-8" />
                <path d="M14 7h7v7" />
              </svg>
            </div>
            <div>
              <div style="
                font-family: 'JetBrains Mono', monospace;
                font-size: 10.5px; color: var(--cf-dim);
                letter-spacing: 0.1em; text-transform: uppercase;
              ">Cierres Q1</div>
              <div style="
                font-family: 'Geist', system-ui, sans-serif;
                font-size: 20px; font-weight: 600;
                color: var(--cf-ink); margin-top: 2px;
              ">−71% tiempo</div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       LOGO STRIP
  ════════════════════════════════════════════════════════════ -->
  <section style="
    padding: 64px 0;
    background: var(--cf-paper);
    border-bottom: 1px solid var(--cf-rule);
  ">
    <div style="max-width: 1240px; margin: 0 auto; padding: 0 40px;">
      <div style="
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 56px;
        align-items: center;
      ">
        <!-- Left: label -->
        <div>
          <Eyebrow>Confían en nosotros</Eyebrow>
          <p style="
            font-family: 'Geist', system-ui, sans-serif;
            font-size: 15px;
            color: var(--cf-dim);
            margin-top: 12px;
            line-height: 1.5;
          ">
            40+ empresas en 12 países han desplegado producción con Camandre.
          </p>
        </div>

        <!-- Right: marquee -->
        <div style="overflow: hidden; position: relative;">
          <div class="cf-marquee" style="width: max-content; display: flex; gap: 64px;">
            {['ACME · INDUSTRIES', 'BANCO NORTE', 'TREVIA · LOGISTICS', 'HELIO HEALTH',
              'NORTHWIND', 'QUANTA ENERGY', 'ESTUDIO PLOMO', 'LUMEN FOODS',
              'ACME · INDUSTRIES', 'BANCO NORTE', 'TREVIA · LOGISTICS', 'HELIO HEALTH',
              'NORTHWIND', 'QUANTA ENERGY', 'ESTUDIO PLOMO', 'LUMEN FOODS'].map((c, i) => (
              <span style="
                font-family: 'JetBrains Mono', monospace;
                font-size: 16px; font-weight: 500;
                color: var(--cf-ink); letter-spacing: 0.05em;
                white-space: nowrap; opacity: 0.78;
              ">{c}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SERVICES
  ════════════════════════════════════════════════════════════ -->
  <section style="padding: 120px 0; background: var(--cf-bg);">
    <div style="max-width: 1240px; margin: 0 auto; padding: 0 40px;">

      <!-- Header -->
      <div style="
        display: flex; align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 56px;
        flex-wrap: wrap; gap: 24px;
      ">
        <div class="cf-reveal" data-cf-reveal style="max-width: 680px;">
          <div style="margin-bottom: 22px;"><Eyebrow>Cómo trabajamos</Eyebrow></div>
          <h2 style="
            font-family: 'Geist', system-ui, sans-serif;
            font-size: 60px; font-weight: 600;
            letter-spacing: -0.035em;
            color: var(--cf-ink); margin: 0; line-height: 1;
          ">
            Cuatro disciplinas.<br />
            <span style="color: var(--cf-dim);">Un solo equipo.</span>
          </h2>
        </div>
        <div class="cf-reveal" data-cf-reveal style="max-width: 320px;">
          <p style="font-size: 16px; line-height: 1.65; color: var(--cf-dim); margin: 0;">
            No subcontratamos. Diseño, ingeniería e infraestructura viven en la misma sala.
          </p>
          <a
            href="/servicios"
            class="cf-navlink"
            style="display: inline-block; margin-top: 18px; font-size: 14px; font-weight: 600; color: var(--cf-ink);"
          >Ver detalle de servicios →</a>
        </div>
      </div>

      <!-- Cards grid -->
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;">
        {[
          {
            n: '01',
            title: 'Producto web a medida',
            body: 'Aplicaciones SaaS, dashboards y portales construidos con Astro, React y un stack que sobrevive a las modas.',
            stack: ['Astro', 'React', 'Tailwind', 'shadcn/ui'],
          },
          {
            n: '02',
            title: 'Sistemas a medida',
            body: 'ERPs, CRMs y operaciones internas. Modelamos tu negocio en software para que escale sin fricción.',
            stack: ['Django', 'PostgreSQL', 'Redis', 'Docker'],
          },
          {
            n: '03',
            title: 'Infraestructura & Cloud',
            body: 'Migración serverless, infraestructura como código y observabilidad. Plataforma técnica invisible cuando funciona.',
            stack: ['GCP', 'AWS', 'Terraform', 'Kubernetes'],
          },
          {
            n: '04',
            title: 'Consultoría TI',
            body: 'Auditorías técnicas, due diligence y hojas de ruta. Recomendaciones que se pueden ejecutar, no PDFs decorativos.',
            stack: ['Audit', 'Strategy', 'Hiring', 'Training'],
          },
        ].map(it => (
          <div
            class="cf-card cf-reveal"
            data-cf-reveal
            style="
              background: var(--cf-paper);
              border: 1px solid var(--cf-rule);
              border-radius: 14px;
              padding: 32px 30px 28px;
              display: flex; flex-direction: column;
              min-height: 280px;
            "
          >
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="
                font-family: 'JetBrains Mono', monospace;
                font-size: 11px; color: var(--cf-brand); letter-spacing: 0.12em;
              ">{it.n}</span>
              <span style="
                font-family: 'JetBrains Mono', monospace;
                font-size: 11px; color: var(--cf-dim); letter-spacing: 0.08em;
              ">4 OFICIOS</span>
            </div>
            <h3 style="
              font-family: 'Geist', system-ui, sans-serif;
              font-size: 26px; font-weight: 600;
              letter-spacing: -0.018em;
              color: var(--cf-ink);
              margin: 20px 0 12px; line-height: 1.2;
            ">{it.title}</h3>
            <p style="
              font-size: 15px; line-height: 1.62;
              color: var(--cf-dim); margin: 0; flex: 1;
            ">{it.body}</p>
            <div style="
              display: flex; flex-wrap: wrap; gap: 6px;
              margin-top: 22px; padding-top: 20px;
              border-top: 1px dashed var(--cf-rule);
            ">
              {it.stack.map(s => (
                <span style="
                  font-family: 'JetBrains Mono', monospace;
                  font-size: 11px; padding: 4px 9px;
                  background: var(--cf-bg2); color: var(--cf-ink);
                  border-radius: 4px; letter-spacing: 0.02em;
                ">{s}</span>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       FEATURED CASE — Helio Health
  ════════════════════════════════════════════════════════════ -->
  <section style="
    padding: 120px 0;
    background: var(--cf-paper);
    border-top: 1px solid var(--cf-rule);
    border-bottom: 1px solid var(--cf-rule);
  ">
    <div style="max-width: 1240px; margin: 0 auto; padding: 0 40px;">

      <!-- Header row -->
      <div style="
        display: flex; align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 56px;
      ">
        <div class="cf-reveal" data-cf-reveal>
          <div style="margin-bottom: 22px;"><Eyebrow>Caso destacado · Helio Health</Eyebrow></div>
          <h2 style="
            font-family: 'Geist', system-ui, sans-serif;
            font-size: 60px; font-weight: 600;
            letter-spacing: -0.035em;
            margin: 0; line-height: 1;
            color: var(--cf-ink); max-width: 720px;
          ">
            Reescribimos un EMR de 14 años<br />
            <span style="color: var(--cf-dim);">en nueve meses, sin un solo downtime.</span>
          </h2>
        </div>
        <a
          href="/portafolio"
          class="cf-navlink"
          style="font-size: 14px; font-weight: 600; color: var(--cf-ink); white-space: nowrap;"
        >Ver más casos →</a>
      </div>

      <!-- Content grid -->
      <div class="cf-reveal" data-cf-reveal style="
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        gap: 64px;
        align-items: center;
      ">

        <!-- Mock product UI -->
        <div style="
          background: var(--cf-navy-deep);
          border-radius: 14px; padding: 24px;
          border: 1px solid #1B2548;
          box-shadow: 0 30px 80px -40px rgba(11,19,43,0.4);
        ">
          <!-- Titlebar dots -->
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 18px;">
            <span style="width: 9px; height: 9px; border-radius: 5px; background: #FF5F56; display: inline-block;"></span>
            <span style="width: 9px; height: 9px; border-radius: 5px; background: #FFBD2E; display: inline-block;"></span>
            <span style="width: 9px; height: 9px; border-radius: 5px; background: #27C93F; display: inline-block;"></span>
            <span style="
              flex: 1;
              font-family: 'JetBrains Mono', monospace;
              font-size: 11px; color: #7E869A; text-align: center;
            ">helio.health · sala de atenciones</span>
          </div>

          <!-- Table -->
          <div style="
            background: #0B1530; border-radius: 10px;
            padding: 16px 18px;
            border: 1px solid #1B2548;
          ">
            <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
              <span style="font-family: 'Geist', system-ui, sans-serif; font-size: 13px; color: #C5CADA;">Atenciones en curso</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--cf-brand);">● en vivo</span>
            </div>
            {[
              { p: 'M. Quispe',  s: 'Hipertensión',  r: 'Sala 02', c: 'var(--cf-brand)' },
              { p: 'A. Ortiz',   s: 'Posoperatorio', r: 'Sala 04', c: '#F5C26B' },
              { p: 'C. Lavalle', s: 'Triage',         r: 'Espera',  c: '#7E869A' },
              { p: 'B. Mamani',  s: 'Pediatría',      r: 'Sala 01', c: 'var(--cf-brand)' },
              { p: 'R. Vega',    s: 'Cardiología',    r: 'Sala 06', c: 'var(--cf-brand)' },
            ].map((r, i) => (
              <div style={`
                display: grid;
                grid-template-columns: 1.2fr 1fr 80px 16px;
                gap: 12px; align-items: center;
                padding: 10px 0;
                border-top: ${i === 0 ? 'none' : '1px solid #1B2548'};
              `}>
                <span style="font-family: 'Geist', system-ui, sans-serif; font-size: 13px; font-weight: 500; color: #FFFFFF;">{r.p}</span>
                <span style="font-family: 'Geist', system-ui, sans-serif; font-size: 12.5px; color: #9BA6BE;">{r.s}</span>
                <span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #7E869A;">{r.r}</span>
                <span style={`width: 8px; height: 8px; border-radius: 4px; background: ${r.c}; display: inline-block; justify-self: end;`}></span>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: text + metrics -->
        <div>
          <p style="
            font-family: 'Geist', system-ui, sans-serif;
            font-size: 19px; line-height: 1.6;
            color: var(--cf-text); margin: 0;
          ">
            Una red de 14 clínicas operaba un EMR del 2010 que ya no podía mantenerse. En nueve meses migramos
